          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta toegang toe in Instellingen om tekeningen in Foto's te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
