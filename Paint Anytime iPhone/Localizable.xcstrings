    "Project queued. It will appear in your watch gallery when the transfer finishes. Open it there to edit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إضافة المشروع إلى قائمة الانتظار. سيظهر في معرض ساعتك عند انتهاء النقل. افتحه هناك لتعديله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt je ve frontě. Po dokončení přenosu se objeví v galerii hodinek. Tam ho otevřete a upravte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektet er sat i kø. Det vises i urets galleri, når overførslen er færdig. Åbn det der for at redigere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt eingereiht. Es erscheint in der Galerie deiner Watch, sobald die Übertragung abgeschlossen ist. Öffne es dort zum Bearbeiten."
