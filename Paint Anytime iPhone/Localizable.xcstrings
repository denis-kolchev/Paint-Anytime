    "The drawing was saved to Photos, but the temporary file could not be deleted: %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ الرسم في الصور، لكن تعذّر حذف الملف المؤقت: %@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kresba byla uložena do Fotek, ale dočasný soubor se nepodařilo smazat: %@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegningen blev gemt i Fotos, men den midlertidige fil kunne ikke slettes: %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeichnung wurde in Fotos gesichert, aber die temporäre Datei konnte nicht gelöscht werden: %@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το σχέδιο αποθηκεύτηκε στις Φωτογραφίες, αλλά δεν ήταν δυνατή η διαγραφή του προσωρινού αρχείου: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The drawing was saved to Photos, but the temporary file could not be deleted: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dibujo se guardó en Fotos, pero no se pudo eliminar el archivo temporal: %@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirros tallennettiin Kuviin, mutta väliaikaista tiedostoa ei voitu poistaa: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dessin a été enregistré dans Photos, mais le fichier temporaire n’a pas pu être supprimé : %@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הציור נשמר בתמונות, אך לא ניתן למחוק את הקובץ הזמני: %@"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rajz mentése a Fotókba sikerült, de az ideiglenes fájl törlése nem: %@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar disimpan ke Foto, tetapi file sementara tidak dapat dihapus: %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disegno è stato salvato in Foto, ma non è stato possibile eliminare il file temporaneo: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絵は「写真」に保存されましたが、一時ファイルを削除できませんでした：%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그림은 사진에 저장되었지만 임시 파일을 삭제하지 못했습니다: %@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegningen ble lagret i Bilder, men den midlertidige filen kunne ikke slettes: %@"
          }
        },
        "nl" : {
