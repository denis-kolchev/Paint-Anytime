    "Allow access in Settings to save drawings to Photos." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول في الإعدادات لحفظ الرسومات في الصور."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud chcete ukládat kresby do Fotek, povolte přístup v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv adgang i Indstillinger for at gemme tegninger i Fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff in den Einstellungen, um Zeichnungen in Fotos zu sichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε την πρόσβαση στις Ρυθμίσεις για να αποθηκεύετε σχέδια στις Φωτογραφίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
