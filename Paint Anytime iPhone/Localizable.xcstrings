    "Photo queued. It will appear in your watch gallery as a new drawing when the transfer finishes. Open it there to edit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إضافة الصورة إلى قائمة الانتظار. ستظهر في معرض ساعتك كرسم جديد عند اكتمال النقل. افتحها هناك لتحريرها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotka je ve frontě. Po dokončení přenosu se objeví v galerii hodinek jako nová kresba. Tam ji otevřete a upravte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoet er sat i kø. Det vises i urets galleri som en ny tegning, når overførslen er færdig. Åbn det der for at redigere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto in der Warteschlange. Es erscheint nach der Übertragung als neue Zeichnung in der Galerie deiner Watch. Öffne es dort zum Bearbeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η φωτογραφία μπήκε στην ουρά. Θα εμφανιστεί στη συλλογή του ρολογιού ως νέο σχέδιο μόλις ολοκληρωθεί η μεταφορά. Ανοίξτε το εκεί για επεξεργασία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo queued. It will appear in your watch gallery as a new drawing when the transfer finishes. Open it there to edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto en cola. Aparecerá en la galería del reloj como un nuevo dibujo cuando termine la transferencia. Ábrelo allí para editarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuva on jonossa. Se näkyy kellon galleriassa uutena piirroksena, kun siirto on valmis. Avaa se siellä muokataksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo en file d’attente. Elle apparaîtra dans la galerie de votre montre comme nouveau dessin une fois le transfert terminé. Ouvrez-la là-bas pour la modifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמונה בתור. היא תופיע בגלריית השעון כציור חדש בסיום ההעברה. פתחו אותה שם כדי לערוך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fotó sorba állítva. Az átvitel végén új rajzként jelenik meg az óra galériájában. Ott nyissa meg a szerkesztéshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto dalam antrean. Foto akan muncul di galeri jam Anda sebagai gambar baru saat transfer selesai. Buka di sana untuk mengedit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto in coda. Apparirà nella galleria dell’orologio come nuovo disegno al termine del trasferimento. Aprilo lì per modificarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を送信待ちに追加しました。転送が完了すると、Watchギャラリーに新しい描画として表示されます。そこで開いて編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진이 대기열에 추가되었습니다. 전송이 끝나면 워치 갤러리에 새 그림으로 나타납니다. 거기서 열어 편집하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildet er i kø. Det vises i klokkegalleriet som en ny tegning når overføringen er ferdig. Åpne det der for å redigere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto in de wachtrij. Hij verschijnt als nieuwe tekening in de galerie van je horloge zodra de overdracht klaar is. Open hem daar om te bewerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcie w kolejce. Po zakończeniu przesyłania pojawi się w galerii zegarka jako nowy rysunek. Otwórz je tam, aby edytować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto na fila. Ela aparecerá na galeria do relógio como um novo desenho quando a transferência terminar. Abra lá para editar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografia em fila. Aparecerá na galeria do relógio como um novo desenho quando a transferência terminar. Abra-a lá para editar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото поставлено в очередь. Когда передача завершится, оно появится в галерее часов как новый рисунок. Откройте его там, чтобы редактировать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilden står i kö. Den visas i klockans galleri som en ny teckning när överföringen är klar. Öppna den där för att redigera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปภาพอยู่ในคิวแล้ว จะปรากฏในแกลเลอรีของนาฬิกาเป็นภาพวาดใหม่เมื่อการโอนเสร็จสิ้น เปิดที่นั่นเพื่อแก้ไข"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf sıraya alındı. Aktarım bitince saat galerinizde yeni bir çizim olarak görünecek. Düzenlemek için orada açın."
