    "Drawings saved on Apple Watch appear in Photos on this iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الرسومات المحفوظة على Apple Watch في تطبيق الصور على هذا الـ iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kresby uložené na Apple Watch se objeví ve Fotkách na tomto iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegninger gemt på Apple Watch vises i Fotos på denne iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Apple Watch gespeicherte Zeichnungen erscheinen in Fotos auf diesem iPhone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα σχέδια που αποθηκεύετε στο Apple Watch εμφανίζονται στις Φωτογραφίες σε αυτό το iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drawings saved on Apple Watch appear in Photos on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dibujos guardados en el Apple Watch aparecen en Fotos en este iPhone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchiin tallennetut piirrokset näkyvät tämän iPhonen Kuvat-apissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dessins enregistrés sur l’Apple Watch apparaissent dans Photos sur cet iPhone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ציורים שנשמרו ב־Apple Watch מופיעים ביישום תמונות ב־iPhone זה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple Watchon mentett rajzok az iPhone Fotók alkalmazásában jelennek meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar yang disimpan di Apple Watch muncul di Foto pada iPhone ini."
          }
        },
        "it" : {
          "stringUnit" : {
