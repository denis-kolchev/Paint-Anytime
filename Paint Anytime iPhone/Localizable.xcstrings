    "Deleting a drawing removes it from both Apple Watch and iPhone. Save a copy to Photos, Files, or another app before deleting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي حذف الرسم إلى إزالته من Apple Watch وiPhone معًا. احفظ نسخة في الصور أو الملفات أو تطبيق آخر قبل الحذف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazáním se kresba odstraní z Apple Watch i z iPhonu. Před smazáním uložte kopii do Fotek, Souborů nebo jiné aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du sletter en tegning, fjernes den fra både Apple Watch og iPhone. Gem en kopi i Fotos, Filer eller en anden app, før du sletter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Löschen wird die Zeichnung von Apple Watch und iPhone entfernt. Sichere vorher eine Kopie in Fotos, Dateien oder einer anderen App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαγραφή ενός σχεδίου το αφαιρεί από το Apple Watch και το iPhone. Αποθηκεύστε ένα αντίγραφο στις Φωτογραφίες, στα Αρχεία ή σε άλλη εφαρμογή πριν από τη διαγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting a drawing removes it from both Apple Watch and iPhone. Save a copy to Photos, Files, or another app before deleting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar un dibujo, se borra del Apple Watch y del iPhone. Guarda una copia en Fotos, Archivos u otra app antes de eliminarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirroksen poistaminen poistaa sen sekä Apple Watchista että iPhonesta. Tallenna kopio Kuviin, Tiedostoihin tai toiseen appiin ennen poistamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer un dessin le retire de l’Apple Watch et de l’iPhone. Enregistrez une copie dans Photos, Fichiers ou une autre app avant de le supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחיקת ציור מסירה אותו גם מה‑Apple Watch וגם מה‑iPhone. שמרו עותק ב„תמונות”, ב„קבצים” או ביישום אחר לפני המחיקה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rajz törlése az Apple Watchról és az iPhone-ról is eltávolítja. Törlés előtt mentsen másolatot a Fotókba, a Fájlokba vagy egy másik appba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus gambar akan menghilangkannya dari Apple Watch dan iPhone. Simpan salinan ke Foto, File, atau app lain sebelum menghapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare un disegno lo rimuove sia da Apple Watch sia da iPhone. Salva una copia in Foto, File o un’altra app prima di eliminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描画を削除すると、Apple WatchとiPhoneの両方から削除されます。削除する前に、写真、ファイル、または別のアプリにコピーを保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그림을 삭제하면 Apple Watch와 iPhone 모두에서 제거됩니다. 삭제하기 전에 사진, 파일 또는 다른 앱에 사본을 저장하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du sletter en tegning, fjernes den fra både Apple Watch og iPhone. Lagre en kopi i Bilder, Filer eller en annen app før du sletter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een tekening verwijdert, verdwijnt deze van zowel Apple Watch als iPhone. Bewaar eerst een kopie in Foto’s, Bestanden of een andere app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie rysunku usuwa go z Apple Watch i z iPhone’a. Przed usunięciem zapisz kopię w Zdjęciach, Plikach lub innej aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar um desenho o remove do Apple Watch e do iPhone. Salve uma cópia no Fotos, no Arquivos ou em outro app antes de apagar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar um desenho remove-o do Apple Watch e do iPhone. Guarde uma cópia em Fotografias, Ficheiros ou noutra app antes de apagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При удалении рисунок удаляется и с Apple Watch, и с iPhone. Сначала сохраните копию в «Фото», «Файлы» или другое приложение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du raderar en teckning tas den bort från både Apple Watch och iPhone. Spara en kopia i Bilder, Filer eller en annan app innan du raderar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลบภาพวาดจะลบออกจากทั้ง Apple Watch และ iPhone บันทึกสำเนาไว้ในรูปภาพ ไฟล์ หรือแอปอื่นก่อนลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir çizimi silmek onu hem Apple Watch’tan hem iPhone’dan kaldırır. Silmeden önce Fotoğraflar’a, Dosyalar’a veya başka bir uygulamaya bir kopya kaydedin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалення малюнка прибирає його і з Apple Watch, і з iPhone. Перед видаленням збережіть копію у Фото, Файли або іншу програму."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa bản vẽ sẽ xóa nó khỏi cả Apple Watch và iPhone. Hãy lưu bản sao vào Ảnh, Tệp hoặc ứng dụng khác trước khi xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除绘图会将其从 Apple Watch 和 iPhone 中移除。删除前，请将副本存储到“照片”“文件”或其他 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除繪圖會將其從 Apple Watch 和 iPhone 移除。刪除前，請將副本儲存到「照片」、「檔案」或其他 App。"
          }
        }
      }
