    "Save a copy to Photos, Files, or another app first. Deletion will sync when your devices reconnect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ نسخة في الصور أو الملفات أو تطبيق آخر أولًا. ستتم مزامنة الحذف عند إعادة اتصال أجهزتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív uložte kopii do Fotek, Souborů nebo jiné aplikace. Smazání se synchronizuje, až se zařízení znovu spojí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem først en kopi i Fotos, Filer eller en anden app. Sletningen synkroniseres, når dine enheder er forbundet igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere zuerst eine Kopie in Fotos, Dateien oder einer anderen App. Das Löschen wird synchronisiert, sobald deine Geräte wieder verbunden sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε πρώτα ένα αντίγραφο στις Φωτογραφίες, στα Αρχεία ή σε άλλη εφαρμογή. Η διαγραφή θα συγχρονιστεί όταν οι συσκευές σας επανασυνδεθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save a copy to Photos, Files, or another app first. Deletion will sync when your devices reconnect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda antes una copia en Fotos, Archivos u otra app. La eliminación se sincronizará cuando tus dispositivos vuelvan a conectarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna ensin kopio Kuviin, Tiedostoihin tai toiseen appiin. Poisto synkronoidaan, kun laitteet yhdistyvät uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez d’abord une copie dans Photos, Fichiers ou une autre app. La suppression sera synchronisée lorsque vos appareils se reconnecteront."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמרו קודם עותק ב„תמונות”, ב„קבצים” או ביישום אחר. המחיקה תסונכרן כשהמכשירים יתחברו מחדש."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először mentsen másolatot a Fotókba, a Fájlokba vagy egy másik appba. A törlés szinkronizálódik, amikor az eszközök újra kapcsolódnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan salinan ke Foto, File, atau app lain terlebih dahulu. Penghapusan akan disinkronkan saat perangkat Anda terhubung kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva prima una copia in Foto, File o un’altra app. L’eliminazione verrà sincronizzata quando i dispositivi si ricollegheranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先に写真、ファイル、または別のアプリにコピーを保存してください。削除はデバイスが再接続されたときに同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 사진, 파일 또는 다른 앱에 사본을 저장하세요. 삭제는 기기가 다시 연결되면 동기화됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre først en kopi i Bilder, Filer eller en annen app. Slettingen synkroniseres når enhetene kobles til igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar eerst een kopie in Foto’s, Bestanden of een andere app. Het verwijderen wordt gesynchroniseerd zodra je apparaten weer verbonden zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zapisz kopię w Zdjęciach, Plikach lub innej aplikacji. Usunięcie zostanie zsynchronizowane po ponownym połączeniu urządzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve uma cópia no Fotos, no Arquivos ou em outro app primeiro. A exclusão será sincronizada quando seus dispositivos se reconectarem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde primeiro uma cópia em Fotografias, Ficheiros ou noutra app. A eliminação será sincronizada quando os dispositivos voltarem a ligar-se."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала сохраните копию в «Фото», «Файлы» или другое приложение. Удаление синхронизируется, когда устройства снова подключатся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara först en kopia i Bilder, Filer eller en annan app. Raderingen synkroniseras när dina enheter ansluts igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกสำเนาไว้ในรูปภาพ ไฟล์ หรือแอปอื่นก่อน การลบจะซิงค์เมื่ออุปกรณ์ของคุณเชื่อมต่ออีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce Fotoğraflar’a, Dosyalar’a veya başka bir uygulamaya bir kopya kaydedin. Silme işlemi cihazlarınız yeniden bağlandığında eşzamanlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спочатку збережіть копію у Фото, Файли або іншу програму. Видалення синхронізується, коли пристрої знову під’єднаються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy lưu bản sao vào Ảnh, Tệp hoặc ứng dụng khác trước. Việc xóa sẽ đồng bộ khi các thiết bị kết nối lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先将副本存储到“照片”“文件”或其他 App。设备重新连接后，删除操作将同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先將副本儲存到「照片」、「檔案」或其他 App。裝置重新連線後，刪除動作將會同步。"
          }
        }
      }
    },
    "Save a drawing in Paint Anytime on your Apple Watch. Open the watch app to sync your existing drawings. Transfers may take a few minutes." : {
      "comment" : "A description of the content of the text.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ رسمًا في Paint Anytime على Apple Watch. افتح التطبيق على الساعة لمزامنة رسوماتك الحالية. قد يستغرق النقل بضع دقائق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte kresbu v Paint Anytime na Apple Watch. Otevřete aplikaci na hodinkách, aby se synchronizovaly stávající kresby. Přenos může trvat několik minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem en tegning i Paint Anytime på dit Apple Watch. Åbn appen på uret for at synkronisere dine eksisterende tegninger. Overførsler kan tage et par minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere eine Zeichnung in Paint Anytime auf deiner Apple Watch. Öffne die App auf der Watch, um vorhandene Zeichnungen zu synchronisieren. Übertragungen können einige Minuten dauern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε ένα σχέδιο στο Paint Anytime στο Apple Watch. Ανοίξτε την εφαρμογή στο ρολόι για να συγχρονίσετε τα υπάρχοντα σχέδια. Η μεταφορά μπορεί να διαρκέσει λίγα λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save a drawing in Paint Anytime on your Apple Watch. Open the watch app to sync your existing drawings. Transfers may take a few minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda un dibujo en Paint Anytime en tu Apple Watch. Abre la app en el reloj para sincronizar tus dibujos. Las transferencias pueden tardar unos minutos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna piirros Paint Anytimessa Apple Watchilla. Avaa kellon appi synkronoidaksesi olemassa olevat piirrokset. Siirrot voivat kestää muutaman minuutin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez un dessin dans Paint Anytime sur votre Apple Watch. Ouvrez l’app sur la montre pour synchroniser vos dessins existants. Les transferts peuvent prendre quelques minutes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שמרו ציור ב‑Paint Anytime ב‑Apple Watch. פתחו את היישום בשעון כדי לסנכרן את הציורים הקיימים. ההעברה עשויה להימשך כמה דקות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentsen egy rajzot a Paint Anytime-ban az Apple Watchon. Nyissa meg az appot az órán a meglévő rajzok szinkronizálásához. Az átvitel néhány percig tarthat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan gambar di Paint Anytime pada Apple Watch Anda. Buka app di jam untuk menyinkronkan gambar yang ada. Transfer dapat memakan waktu beberapa menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva un disegno in Paint Anytime su Apple Watch. Apri l’app sull’orologio per sincronizzare i disegni esistenti. I trasferimenti possono richiedere alcuni minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple WatchのPaint Anytimeで描画を保存してください。既存の描画を同期するには、Watchのアプリを開きます。転送には数分かかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch의 Paint Anytime에서 그림을 저장하세요. 기존 그림을 동기화하려면 Watch 앱을 여세요. 전송에는 몇 분이 걸릴 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre en tegning i Paint Anytime på Apple Watch. Åpne appen på klokken for å synkronisere eksisterende tegninger. Overføringer kan ta noen minutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar een tekening in Paint Anytime op je Apple Watch. Open de app op je horloge om bestaande tekeningen te synchroniseren. Overdrachten kunnen enkele minuten duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz rysunek w Paint Anytime na Apple Watch. Otwórz aplikację na zegarku, aby zsynchronizować istniejące rysunki. Przesyłanie może potrwać kilka minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve um desenho no Paint Anytime no Apple Watch. Abra o app no relógio para sincronizar os desenhos existentes. As transferências podem levar alguns minutos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde um desenho no Paint Anytime no Apple Watch. Abra a app no relógio para sincronizar os desenhos existentes. As transferências podem demorar alguns minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните рисунок в Paint Anytime на Apple Watch. Откройте приложение на часах, чтобы синхронизировать существующие рисунки. Передача может занять несколько минут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara en teckning i Paint Anytime på din Apple Watch. Öppna appen på klockan för att synkronisera befintliga teckningar. Överföringar kan ta några minuter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกภาพวาดใน Paint Anytime บน Apple Watch ของคุณ เปิดแอปบนนาฬิกาเพื่อซิงค์ภาพวาดที่มีอยู่ การโอนอาจใช้เวลาสองสามนาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch’unuzdaki Paint Anytime’da bir çizim kaydedin. Mevcut çizimlerinizi eşzamanlamak için saat uygulamasını açın. Aktarımlar birkaç dakika sürebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть малюнок у Paint Anytime на Apple Watch. Відкрийте програму на годиннику, щоб синхронізувати наявні малюнки. Передавання може тривати кілька хвилин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu một bản vẽ trong Paint Anytime trên Apple Watch. Mở ứng dụng trên đồng hồ để đồng bộ các bản vẽ hiện có. Việc chuyển có thể mất vài phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple Watch 上的 Paint Anytime 中存储绘图。打开手表 App 以同步现有绘图。传输可能需要几分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple Watch 上的 Paint Anytime 中儲存繪圖。開啟手錶 App 以同步現有繪圖。傳輸可能需要幾分鐘。"
          }
        }
