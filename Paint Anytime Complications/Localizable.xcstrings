    "Open a fresh canvas in Paint Anytime.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح لوحة فارغة في Paint Anytime."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete prázdné plátno v Paint Anytime."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn et tomt lærred i Paint Anytime."
          }
        },
