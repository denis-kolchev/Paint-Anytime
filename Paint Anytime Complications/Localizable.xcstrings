            "value": "Otwórz puste płótno w Paint Anytime."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma tela vazia no Paint Anytime."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma tela vazia no Paint Anytime."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть чистый холст в Paint Anytime."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna en tom duk i Paint Anytime."
