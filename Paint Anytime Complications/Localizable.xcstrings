        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте чисте полотно в Paint Anytime."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khung vẽ trống trong Paint Anytime."
          }
        },
        "zh-Hans": {
