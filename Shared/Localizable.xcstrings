        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba Deshacer y Rehacer abajo. Usa estos botones dos veces en total."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente Desfazer e Refazer em baixo. Use estes botões duas vezes no total."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب التراجع والإعادة في الأسفل. استخدم الزرين مرتين إجمالًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の取り消しとやり直しを試しましょう。合計2回使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래의 실행 취소와 다시 실행을 써보세요. 두 버튼을 합쳐 두 번 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试底部的撤销和重做按钮，总共使用两次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試試底部的還原和重做按鈕，總共使用兩次。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alttaki Geri al ve Yinele düğmelerini toplam iki kez kullan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj Cofnij i Ponów na dole. Użyj tych przycisków łącznie dwa razy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer onderaan Ongedaan maken en Opnieuw. Gebruik de knoppen in totaal twee keer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Ångra och Gör om längst ner. Använd knapparna totalt två gånger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv Fortryd og Gentag nederst. Brug knapperne to gange i alt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv Angre og Gjør om nederst. Bruk knappene totalt to ganger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile alhaalta Kumoa ja Tee uudelleen. Käytä painikkeita yhteensä kahdesti."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे पूर्ववत और फिर करें बटन आज़माएँ। इनका कुल दो बार इस्तेमाल करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கீழே உள்ள செயல்தவிர் மற்றும் மீண்டும் செய் பொத்தான்களை மொத்தம் இரண்டு முறை பயன்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దిగువన రద్దు మరియు మళ్లీ చేయి బటన్లను మొత్తం రెండుసార్లు వాడండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खालील पूर्ववत आणि पुन्हा करा बटणे एकूण दोनदा वापरा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નીચેનાં પૂર્વવત્ અને ફરી કરો બટનો કુલ બે વાર વાપરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੇਠਲੇ ਵਾਪਸ ਅਤੇ ਮੁੜ ਕਰੋ ਬਟਨ ਕੁੱਲ ਦੋ ਵਾਰ ਵਰਤੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিচের পূর্বাবস্থা এবং আবার করুন বোতাম মোট দুবার ব্যবহার করুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba Urungkan dan Ulangi di bawah. Gunakan tombol-tombol ini sebanyak dua kali."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیچے کالعدم اور دوبارہ کریں کے بٹن کل دو بار استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử Hoàn tác và Làm lại ở dưới. Dùng các nút này tổng cộng hai lần."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองปุ่มเลิกทำและทำซ้ำด้านล่าง ใช้ปุ่มเหล่านี้รวมสองครั้ง"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba Buat asal dan Buat semula di bawah. Gunakan butang ini sebanyak dua kali keseluruhannya."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте кнопки «Скасувати» та «Повторити» внизу. Натисніть їх загалом двічі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyzkoušejte dole tlačítka Zpět a Znovu. Použijte je celkem dvakrát."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă Anulează și Refă în partea de jos. Folosește aceste butoane de două ori în total."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbáld ki alul a Visszavonás és az Újra gombot. Összesen kétszer használd őket."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε Αναίρεση και Επανάληψη στο κάτω μέρος. Χρησιμοποιήστε τα κουμπιά συνολικά δύο φορές."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסו את ״ביטול פעולה״ ו״ביצוע חוזר״ למטה. השתמשו בכפתורים פעמיים בסך הכול."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskúšajte dole tlačidlá Odvolať a Znovu. Použite ich celkovo dvakrát."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isprobajte Poništi i Ponovi pri dnu. Upotrijebite te gumbe ukupno dva puta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preizkusite Razveljavi in Uveljavi spodaj. Gumba uporabite skupaj dvakrat."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Desfés i Refés a baix. Fes servir aquests botons dues vegades en total."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente Desfazer e Refazer em baixo. Use estes botões duas vezes no total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente Desfazer e Refazer na parte inferior. Use esses botões duas vezes no total."
          }
        }
      }
    },
    "Save your drawing with the button in the lower-right corner. It goes into the temporary tutorial gallery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your drawing with the button in the lower-right corner. It goes into the temporary tutorial gallery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохрани рисунок кнопкой в правом нижнем углу. Он попадёт во временную учебную галерею."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ton dessin avec le bouton en bas à droite. Il rejoint la galerie temporaire du tutoriel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere die Zeichnung mit der Taste unten rechts in der vorübergehenden Übungsgalerie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il disegno con il pulsante in basso a destra nella galleria temporanea del tutorial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el dibujo con el botón inferior derecho en la galería temporal del tutorial."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o desenho com o botão inferior direito na galeria temporária do tutorial."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ الرسم بالزر الأسفل في معرض التدريب المؤقت."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右下の保存ボタンをタップします。作品は練習用の一時ギャラリーに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 아래 저장 버튼을 누르세요. 그림은 임시 연습 갤러리에 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击右下角保存。作品会保存到临时练习画廊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下右下角儲存。作品會儲存到臨時練習圖庫。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ alttaki düğmeyle çizimini geçici eğitim galerisine kaydet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz rysunek przyciskiem w prawym dolnym rogu w tymczasowej galerii samouczka."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla je tekening met de knop rechtsonder op in de tijdelijke oefengalerij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara teckningen med knappen nere till höger i guidens tillfälliga galleri."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem tegningen med knappen nederst til højre i vejledningens midlertidige galleri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre tegningen med knappen nederst til høyre i omvisningens midlertidige galleri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna piirros oikean alakulman painikkeella opastuksen väliaikaiseen galleriaan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे दाईं ओर के बटन से चित्र सहेजें। यह अस्थायी प्रशिक्षण गैलरी में जाएगा।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கீழ் வலப்புறப் பொத்தானால் ஓவியத்தைச் சேமியுங்கள். அது தற்காலிகப் பயிற்சிக் கேலரியில் சேரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దిగువ కుడి మూల బటన్‌తో చిత్రాన్ని సేవ్ చేయండి. అది తాత్కాలిక శిక్షణ గ్యాలరీలో చేరుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली उजवीकडील बटणाने चित्र जतन करा. ते तात्पुरत्या प्रशिक्षण गॅलरीत जाईल."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નીચે જમણી બાજુના બટનથી ચિત્ર સાચવો. તે કામચલાઉ તાલીમ ગૅલેરીમાં જશે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੇਠਾਂ ਸੱਜੇ ਬਟਨ ਨਾਲ ਚਿੱਤਰ ਸੰਭਾਲੋ। ਇਹ ਅਸਥਾਈ ਸਿਖਲਾਈ ਗੈਲਰੀ ਵਿੱਚ ਜਾਵੇਗਾ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিচের ডান কোণের বোতাম দিয়ে ছবিটি সংরক্ষণ করুন। এটি অস্থায়ী প্রশিক্ষণ গ্যালারিতে যাবে।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan gambar dengan tombol di kanan bawah. Gambar masuk ke galeri tutorial sementara."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیچے محفوظ کرنے کا بٹن دبائیں۔ تصویر عارضی تربیتی گیلری میں جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu tranh bằng nút ở góc dưới bên phải. Tranh được đưa vào bộ sưu tập hướng dẫn tạm thời."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกภาพด้วยปุ่มที่มุมขวาล่าง ภาพจะอยู่ในแกลเลอรีบทสอนชั่วคราว"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan lukisan dengan butang di kanan bawah. Lukisan masuk ke galeri tutorial sementara."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть малюнок кнопкою праворуч унизу. Він потрапить до тимчасової навчальної галереї."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte kresbu tlačítkem vpravo dole. Uloží se do dočasné výukové galerie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează desenul cu butonul din dreapta jos. Acesta ajunge în galeria temporară a tutorialului."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd a rajzot a jobb alsó gombbal. Az ideiglenes gyakorlógalériába kerül."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε το σχέδιο με το κουμπί κάτω δεξιά. Θα μπει στην προσωρινή συλλογή εκμάθησης."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו את הציור באמצעות כפתור השמירה למטה. הוא יתווסף לגלריית ההדרכה הזמנית."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte kresbu tlačidlom vpravo dole. Uloží sa do dočasnej výučbovej galérie."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremite crtež gumbom dolje desno. Spremit će se u privremenu galeriju vodiča."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranite risbo z gumbom spodaj desno. Shranjena bo v začasno galerijo vodiča."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa el dibuix amb el botó de la part inferior dreta. Anirà a la galeria temporal del tutorial."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
