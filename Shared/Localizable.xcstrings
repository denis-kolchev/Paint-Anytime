      }
    },
    "Share width, opacity, and color across tools. Color and opacity do not apply to the eraser." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم سُمكًا وعتامة ولونًا مشتركًا بين الأدوات. لا ينطبق اللون والعتامة على الممحاة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílejte tloušťku, krytí a barvu mezi nástroji. Barva a krytí se nevztahují na gumu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del tykkelse, opacitet og farve mellem værktøjerne. Farve og opacitet gælder ikke for viskelæderet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile Breite, Deckkraft und Farbe zwischen den Werkzeugen. Farbe und Deckkraft gelten nicht für den Radierer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε κοινό πάχος, διαφάνεια και χρώμα στα εργαλεία. Το χρώμα και η διαφάνεια δεν ισχύουν για τη γόμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share width, opacity, and color across tools. Color and opacity do not apply to the eraser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte el grosor, la opacidad y el color entre herramientas. El color y la opacidad no se aplican a la goma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa paksuus, peittävyys ja väri työkalujen kesken. Väri ja peittävyys eivät koske pyyhekumia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez l’épaisseur, l’opacité et la couleur entre les outils. La couleur et l’opacité ne s’appliquent pas à la gomme."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמשו בעובי, באטימות ובצבע משותפים לכלים. צבע ואטימות אינם חלים על המחק."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használj közös vastagságot, fedettséget és színt az eszközöknél. A szín és a fedettség nem vonatkozik a radírra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan ketebalan, opasitas, dan warna yang sama untuk semua alat. Warna dan opasitas tidak berlaku untuk penghapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi spessore, opacità e colore tra gli strumenti. Il colore e l’opacità non si applicano alla gomma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツール間で太さ、透明度、色を共有します。色と透明度は消しゴムには適用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구 간에 두께, 투명도, 색상을 공유합니다. 색상과 투명도는 지우개에 적용되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del tykkelse, opasitet og farge mellom verktøyene. Farge og opasitet gjelder ikke for viskelæret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel dikte, dekking en kleur tussen gereedschappen. Kleur en dekking gelden niet voor de gum."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj wspólnej grubości, krycia i koloru we wszystkich narzędziach. Kolor i krycie nie dotyczą gumki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe a espessura, a opacidade e a cor entre as ferramentas. A cor e a opacidade não se aplicam à borracha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partilhe a espessura, a opacidade e a cor entre ferramentas. A cor e a opacidade não se aplicam à borracha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте общую толщину, прозрачность и цвет для всех инструментов. Цвет и прозрачность не применяются к стиралке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela tjocklek, opacitet och färg mellan verktygen. Färg och opacitet gäller inte för suddgummit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ความหนา ความทึบ และสีร่วมกันระหว่างเครื่องมือ สีและความทึบไม่ใช้กับยางลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araçlar arasında kalınlık, opaklık ve rengi paylaş. Renk ve opaklık silgi için geçerli değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте спільну товщину, прозорість і колір для всіх інструментів. Колір і прозорість не застосовуються до гумки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng chung độ dày, độ mờ đục và màu giữa các công cụ. Màu và độ mờ đục không áp dụng cho tẩy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在工具间共用粗细、透明度和颜色。颜色和透明度不适用于橡皮擦。"
