    "This drawing was saved without stroke data and cannot be restored for editing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This drawing was saved without stroke data and cannot be restored for editing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот рисунок сохранён без данных штрихов и не может быть восстановлен для редактирования."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظ هذا الرسم دون بيانات الخطوط ولا يمكن استعادته للتعديل."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dessin a été enregistré sans données de traits et ne peut pas être restauré pour être modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zeichnung wurde ohne Strichdaten gespeichert und kann nicht zur Bearbeitung wiederhergestellt werden."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ड्रॉइंग रेखाओं के डेटा के बिना सहेजी गई थी और बदलाव के लिए वापस नहीं लाई जा सकती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo disegno è stato salvato senza i dati dei tratti e non può essere ripristinato per la modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この描画には線のデータが保存されていないため、編集用に復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그림은 선 데이터 없이 저장되어 편집용으로 복원할 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este desenho foi guardado sem os dados dos traços e não pode ser restaurado para edição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此画作保存时未包含笔画数据，无法恢复以进行编辑。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dibujo se guardó sin datos de los trazos y no se puede recuperar para editarlo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çizim, çizgi verileri olmadan kaydedildi ve düzenlemek için geri yüklenemez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此畫作儲存時未包含筆畫資料，無法回復以進行編輯。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten rysunek zapisano bez danych kresek i nie można go przywrócić do edycji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze tekening is zonder lijngegevens opgeslagen en kan niet worden hersteld om te bewerken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här teckningen sparades utan streckdata och kan inte återställas för redigering."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tegning blev gemt uden stregdata og kan ikke gendannes til redigering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tegningen ble lagret uten strekdata og kan ikke gjenopprettes for redigering."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä piirros tallennettiin ilman viivatietoja, eikä sitä voi palauttaa muokattavaksi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஓவியம் கோட்டுத் தரவுகள் இல்லாமல் சேமிக்கப்பட்டதால், திருத்துவதற்காக மீட்டெடுக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ డ్రాయింగ్ గీతల డేటా లేకుండా సేవ్ చేయబడింది. సవరించడానికి దాన్ని పునరుద్ధరించలేము."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे रेखाचित्र रेषांच्या डेटाशिवाय जतन केले आहे आणि संपादनासाठी पुनर्संचयित करता येणार नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ રેખાચિત્ર રેખાઓના ડેટા વિના સાચવવામાં આવ્યું હતું અને સંપાદન માટે પુનઃસ્થાપિત કરી શકાતું નથી."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਚਿੱਤਰ ਲਕੀਰਾਂ ਦੇ ਡਾਟੇ ਤੋਂ ਬਿਨਾਂ ਸੰਭਾਲਿਆ ਗਿਆ ਸੀ ਅਤੇ ਸੋਧਣ ਲਈ ਬਹਾਲ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আঁকা ছবিটি রেখার ডেটা ছাড়া সেভ করা হয়েছে এবং সম্পাদনার জন্য ফিরিয়ে আনা যাবে না।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar ini disimpan tanpa data goresan dan tidak dapat dipulihkan untuk diedit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ڈرائنگ لکیروں کے ڈیٹا کے بغیر محفوظ کی گئی تھی اور ترمیم کے لیے بحال نہیں ہو سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản vẽ này được lưu mà không có dữ liệu nét vẽ nên không thể khôi phục để chỉnh sửa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพวาดนี้บันทึกโดยไม่มีข้อมูลเส้น จึงไม่สามารถกู้คืนเพื่อแก้ไขได้"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukisan ini disimpan tanpa data garisan dan tidak dapat dipulihkan untuk diedit."
          }
        }
      }
    },
