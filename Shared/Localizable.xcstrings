        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sola kaydır veya alttaki Kalınlık seçeneğine dokun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w lewo lub stuknij Grubość na dole, aby otworzyć ustawienie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg naar links of tik onderaan op Dikte om de instelling te openen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep åt vänster eller tryck på Tjocklek längst ner för att öppna inställningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub til venstre eller tryk på Tykkelse nederst for at åbne indstillingen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip til venstre eller trykk på Tykkelse nederst for å åpne innstillingen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa asetus pyyhkäisemällä vasemmalle tai napauttamalla alhaalta Paksuus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चौड़ाई सेटिंग खोलने के लिए बाईं ओर स्वाइप करें या नीचे चौड़ाई पर टैप करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அகல அமைப்பைத் திறக்க இடப்புறம் ஸ்வைப் செய்யுங்கள் அல்லது கீழே அகலத்தைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెడల్పు సెట్టింగ్ తెరవడానికి ఎడమవైపు స్వైప్ చేయండి లేదా దిగువన వెడల్పును నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रुंदीचे सेटिंग उघडण्यासाठी डावीकडे स्वाइप करा किंवा खाली रुंदीवर टॅप करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પહોળાઈની સેટિંગ ખોલવા ડાબી તરફ સ્વાઇપ કરો અથવા નીચે પહોળાઈ પર ટૅપ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੌੜਾਈ ਦੀ ਸੈਟਿੰਗ ਖੋਲ੍ਹਣ ਲਈ ਖੱਬੇ ਸਵਾਈਪ ਕਰੋ ਜਾਂ ਹੇਠਾਂ ਚੌੜਾਈ ਨੂੰ ਟੈਪ ਕਰੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্থের সেটিং খুলতে বাঁয়ে সোয়াইপ করুন বা নিচে প্রস্থে ট্যাপ করুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser ke kiri atau ketuk Lebar di bawah untuk membuka pengaturan lebar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چوڑائی کی ترتیب کھولنے کے لیے بائیں سوائپ کریں یا نیچے چوڑائی کو تھپتھپائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt sang trái hoặc chạm Độ rộng ở dưới để mở cài đặt độ rộng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดไปทางซ้ายหรือแตะความกว้างด้านล่างเพื่อเปิดการตั้งค่าความกว้าง"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret ke kiri atau ketik Lebar di bawah untuk membuka tetapan lebar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть пальцем ліворуч або натисніть «Товщина» внизу, щоб відкрити її налаштування."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejeďte doleva nebo klepněte dole na Tloušťku a otevřete její nastavení."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisează spre stânga sau atinge Grosime în partea de jos pentru a deschide configurarea."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legyints balra, vagy koppints alul a Vastagságra a beállítás megnyitásához."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαρώστε αριστερά ή πατήστε Πάχος στο κάτω μέρος για να ανοίξετε τη ρύθμιση."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החליקו שמאלה או הקישו על ״עובי״ למטה כדי לפתוח את ההגדרה."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnite doľava alebo klepnite dole na Hrúbku a otvorte jej nastavenie."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijeđite prstom ulijevo ili dodirnite Debljina pri dnu za otvaranje postavke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsnite levo ali tapnite Debelina spodaj, da odprete nastavitev."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llisca cap a l’esquerra o toca Gruix a baix per obrir-ne l’ajust."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a esquerda ou toque em Espessura em baixo para abrir a definição."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a esquerda ou toque em Espessura na parte inferior para abrir o ajuste."
          }
        }
      }
    },
