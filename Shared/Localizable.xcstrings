    "Selected settings are shared across tools. Color does not apply to the eraser.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected settings are shared across tools. Color does not apply to the eraser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные параметры общие для инструментов. Цвет не применяется к ластику."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعدادات المحددة مشتركة بين الأدوات. لا ينطبق اللون على الممحاة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages sélectionnés sont communs aux outils. La couleur ne s’applique pas à la gomme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählten Einstellungen gelten für alle Werkzeuge. Die Farbe gilt nicht für den Radierer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी गई सेटिंग सभी टूल के लिए समान हैं। रंग रबर पर लागू नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni selezionate sono condivise tra gli strumenti. Il colore non si applica alla gomma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した設定はツール間で共有されます。色は消しゴムには適用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 설정은 도구 간에 공유됩니다. 색상은 지우개에 적용되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições selecionadas são partilhadas entre ferramentas. A cor não se aplica à borracha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选设置在各工具间共用。颜色不适用于橡皮擦。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes seleccionados se comparten entre herramientas. El color no se aplica a la goma."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen ayarlar araçlar arasında paylaşılır. Renk silgiye uygulanmaz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選設定會在工具間共用。顏色不適用於橡皮擦。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane ustawienia są wspólne dla narzędzi. Kolor nie dotyczy gumki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde instellingen worden gedeeld tussen gereedschappen. Kleur is niet van toepassing op de gum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De valda inställningarna delas mellan verktygen. Färgen gäller inte suddgummit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De valgte indstillinger deles mellem værktøjerne. Farven gælder ikke for viskelæderet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De valgte innstillingene deles mellom verktøyene. Fargen gjelder ikke for viskelæret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitut asetukset ovat yhteisiä työkaluille. Väri ei koske pyyhekumia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த அமைப்புகள் கருவிகளிடையே பகிரப்படும். நிறம் அழிப்பானுக்குப் பொருந்தாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న సెట్టింగ్‌లు అన్ని సాధనాలకు ఉమ్మడిగా ఉంటాయి. రంగు ఎరేజర్‌కు వర్తించదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेल्या सेटिंग्ज सर्व साधनांसाठी समान आहेत. रंग खोडरबरला लागू होत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલી સેટિંગ્સ બધા સાધનો માટે સમાન છે. રંગ રબરને લાગુ પડતો નથી."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੀਆਂ ਸੈਟਿੰਗਾਂ ਸਾਰੇ ਸੰਦਾਂ ਲਈ ਸਾਂਝੀਆਂ ਹਨ। ਰੰਗ ਰਬੜ ’ਤੇ ਲਾਗੂ ਨਹੀਂ ਹੁੰਦਾ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেছে নেওয়া সেটিংস সব টুলের জন্য একই। রং রাবারের ক্ষেত্রে প্রযোজ্য নয়।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan yang dipilih digunakan bersama oleh semua alat. Warna tidak berlaku untuk penghapus."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب ترتیبات سبھی ٹولز کے لیے مشترک ہیں۔ رنگ ربڑ پر لاگو نہیں ہوتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cài đặt đã chọn được dùng chung giữa các công cụ. Màu không áp dụng cho tẩy."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าที่เลือกใช้ร่วมกันระหว่างเครื่องมือ สีจะไม่ใช้กับยางลบ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seting yang dipilih dikongsi antara alat. Warna tidak digunakan pada pemadam."
          }
        }
      }
    },
    "Share": {
      "extractionState": "manual",
      "localizations": {
        "en": {
