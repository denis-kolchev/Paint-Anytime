    },
    "A rounded calligraphy nib varies line width with stroke direction.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rounded calligraphy nib varies line width with stroke direction."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скруглённое каллиграфическое перо меняет толщину линии в зависимости от направления движения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر سن الخط المستدير سُمك الخط حسب اتجاه الحركة."
          }
        },
        "fr": {
          "stringUnit": {
