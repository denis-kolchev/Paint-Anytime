        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyisd meg a „Szög” elemet, majd forgasd a Crownt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka “Sudut”, lalu putar Crown."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri «Angolo» e ruota la Crown."
          }
        },
