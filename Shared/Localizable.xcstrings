        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Округлий каліграфічний наконечник змінює товщину лінії залежно від напрямку штриха."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaoblený kaligrafický hrot mění tloušťku čáry podle směru tahu."
          }
