    "Keep drawing controls in one menu for fewer buttons on the canvas and more room to draw." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجمع أدوات الرسم في قائمة واحدة لتقليل الأزرار على اللوحة وتوفير مساحة أكبر للرسم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seskupte nástroje do jedné nabídky, aby na plátně bylo méně tlačítek a více místa na kreslení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saml tegneværktøjerne i én menu, så der er færre knapper på lærredet og mere plads til at tegne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasse die Zeichenwerkzeuge in einem Menü zusammen: weniger Schaltflächen auf der Leinwand und mehr Platz zum Zeichnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συγκεντρώστε τα εργαλεία σχεδίασης σε ένα μενού για λιγότερα κουμπιά στον καμβά και περισσότερο χώρο για σχέδιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep drawing controls in one menu for fewer buttons on the canvas and more room to draw."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupa los controles en un solo menú para tener menos botones en el lienzo y más espacio para dibujar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokoa piirtotyökalut yhteen valikkoon, niin piirtoalueella on vähemmän painikkeita ja enemmän tilaa piirtää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regroupez les commandes dans un seul menu pour réduire le nombre de boutons sur la toile et avoir plus de place pour dessiner."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ריכוז כלי הציור בתפריט אחד מפחית את מספר הכפתורים על משטח הציור ומפנה יותר מקום לצייר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyűjtsd a rajzeszközöket egyetlen menübe, hogy kevesebb gomb legyen a vásznon, és több hely maradjon a rajzoláshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satukan kontrol menggambar dalam satu menu agar tombol di kanvas lebih sedikit dan ruang menggambar lebih luas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggruppa i comandi in un unico menu per avere meno pulsanti sulla tela e più spazio per disegnare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描画操作を1つのメニューにまとめることで、キャンバス上のボタンが減り、描くスペースが広がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그리기 도구를 하나의 메뉴에 모아 캔버스의 버튼을 줄이고 그릴 공간을 넓힙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samle tegneverktøyene i én meny for færre knapper på lerretet og mer plass til å tegne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bundel de tekenbediening in één menu voor minder knoppen op het canvas en meer ruimte om te tekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbierz narzędzia w jednym menu, aby na płótnie było mniej przycisków i więcej miejsca do rysowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupe os controles em um único menu para ter menos botões na tela e mais espaço para desenhar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupe os controlos num único menu para ter menos botões na tela e mais espaço para desenhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопки собраны в одном меню: они меньше закрывают холст и оставляют больше места для рисования."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samla ritverktygen i en meny för färre knappar på arbetsytan och mer plats att rita."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รวมเครื่องมือวาดไว้ในเมนูเดียว เพื่อลดจำนวนปุ่มบนผืนผ้าใบและเพิ่มพื้นที่ในการวาดรูป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çizim kontrollerini tek bir menüde toplayarak tuvaldeki düğmeleri azaltın ve çizmek için daha fazla alan açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопки зібрано в одному меню: вони менше закривають полотно й залишають більше місця для малювання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gộp các công cụ vẽ vào một menu để giảm số nút trên khung vẽ và có thêm không gian để vẽ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将绘画工具集中到一个菜单中，减少画布上的按钮，留出更多绘画空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將繪畫工具集中到一個選單中，減少畫布上的按鈕，留出更多繪畫空間。"
          }
        }
      }
    },
