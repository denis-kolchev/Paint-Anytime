    },
    "Tap the green checkmark to return to the canvas, then draw two strokes with your new brush.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the green checkmark to return to the canvas, then draw two strokes with your new brush."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми зелёную галочку, чтобы вернуться к холсту, и нарисуй два штриха новой кистью."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche la coche verte pour revenir à la toile, puis trace deux traits avec ce pinceau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den grünen Haken, um zur Leinwand zurückzukehren, und zeichne zwei Striche mit dem neuen Pinsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il segno di spunta verde per tornare alla tela, poi disegna due tratti con il nuovo pennello."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la marca verde para volver al lienzo y dibuja dos trazos con el pincel nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط علامة الصح الخضراء للعودة إلى اللوحة، ثم ارسم خطين بالفرشاة الجديدة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑のチェックをタップしてキャンバスに戻り、新しいブラシで2本の線を描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초록 체크 표시를 눌러 캔버스로 돌아가 새 브러시로 선 두 개를 그리세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击绿色对勾返回画布，用新画笔画两笔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下綠色勾號返回畫布，用新畫筆畫兩筆。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeşil onay işaretine dokunarak tuvale dön ve yeni fırçayla iki çizgi çiz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij zielony znacznik, aby wrócić do płótna, i narysuj dwie kreski nowym pędzlem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het groene vinkje om naar het canvas terug te keren en teken twee lijnen met de nieuwe kwast."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på den gröna bocken för att återgå till duken och rita två streck med den nya penseln."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på det grønne flueben for at vende tilbage til lærredet og tegn to streger med den nye pensel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på det grønne merket for å gå tilbake til lerretet, og tegn to streker med den nye penselen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaa piirtoalueelle vihreästä valintamerkistä ja piirrä kaksi viivaa uudella siveltimellä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tanda centang hijau untuk kembali ke kanvas, lalu buat dua goresan dengan kuas baru."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm dấu tích xanh để về khung vẽ, rồi vẽ hai nét bằng cọ mới."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเครื่องหมายถูกสีเขียวเพื่อกลับสู่ผืนผ้าใบ แล้ววาดสองเส้นด้วยแปรงใหม่"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть зелену галочку, щоб повернутися до полотна, і намалюйте два штрихи новим пензлем."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeleným zatržítkem se vraťte na plátno a nakreslete dva tahy novým štětcem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A zöld pipával térj vissza a vászonhoz, és rajzolj két vonást az új ecsettel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το πράσινο σημάδι επιλογής για επιστροφή στον καμβά και σχεδιάστε δύο πινελιές με το νέο πινέλο."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על סימן האישור הירוק כדי לחזור למשטח הציור, וציירו שתי משיכות במברשת החדשה."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no visto verde para voltar à tela e desenhe dois traços com o novo pincel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na marca de seleção verde para voltar à tela e desenhe dois traços com o novo pincel."
          }
        }
      }
    },
    "Turn the Digital Crown to zoom the canvas in or out, then stop turning.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the Digital Crown to zoom the canvas in or out, then stop turning."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покрути колёсико часов, чтобы приблизить или отдалить холст, затем остановись."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne la Digital Crown pour zoomer sur la toile, puis arrête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehe die Digital Crown, um die Leinwand zu vergrößern oder zu verkleinern. Höre dann auf zu drehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota la Digital Crown per ingrandire o ridurre la tela, poi fermati."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la Digital Crown para acercar o alejar el lienzo y después deja de girar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدر Digital Crown لتكبير اللوحة أو تصغيرها، ثم توقف."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital Crownを回してキャンバスを拡大・縮小し、回すのを止めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital Crown을 돌려 캔버스를 확대하거나 축소한 뒤 멈추세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转动数码表冠缩放画布，然后停止转动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉動數位錶冠縮放畫布，然後停止轉動。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital Crown’u çevirerek tuvali yakınlaştır veya uzaklaştır, sonra dur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obróć Digital Crown, aby przybliżyć lub oddalić płótno, a potem przestań obracać."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai de Digital Crown om in of uit te zoomen en stop daarna met draaien."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid på Digital Crown för att zooma in eller ut och sluta sedan vrida."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drej Digital Crown for at zoome ind eller ud og stop derefter med at dreje."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vri Digital Crown for å zoome inn eller ut, og slutt deretter å vri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähennä tai loitonna piirtoaluetta kiertämällä Digital Crownia ja lopeta sitten kiertäminen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar Digital Crown untuk memperbesar atau memperkecil kanvas, lalu berhenti memutar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoay Digital Crown để phóng to hoặc thu nhỏ khung vẽ, rồi ngừng xoay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมุน Digital Crown เพื่อซูมผืนผ้าใบเข้าหรือออก แล้วหยุดหมุน"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверніть Digital Crown, щоб змінити масштаб полотна, а потім зупиніться."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otáčením Digital Crown přibližte nebo oddalte plátno, pak přestaňte otáčet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Digital Crown forgatásával nagyítsd vagy kicsinyítsd a vásznat, majd állj meg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιστρέψτε το Digital Crown για μεγέθυνση ή σμίκρυνση του καμβά και μετά σταματήστε."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סובבו את ה-Digital Crown כדי להגדיל או להקטין את משטח הציור, ואז הפסיקו לסובב."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rode a Digital Crown para ampliar ou reduzir a tela e depois pare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire a Digital Crown para ampliar ou reduzir a tela e depois pare de girar."
          }
        }
      }
    },
    "You are in camera mode. Drag to move the canvas, then tap the green checkmark.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are in camera mode. Drag to move the canvas, then tap the green checkmark."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас включён режим камеры. Подвигай холст пальцем, затем нажми зелёную галочку."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es en mode caméra. Déplace la toile avec le doigt, puis touche la coche verte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist im Kameramodus. Verschiebe die Leinwand mit dem Finger und tippe auf den grünen Haken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei in modalità fotocamera. Trascina la tela, poi tocca il segno di spunta verde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en modo cámara. Arrastra el lienzo y toca la marca verde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت في وضع الكاميرا. حرّك اللوحة بإصبعك ثم اضغط علامة الصح الخضراء."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラモードです。指でキャンバスを動かしてから緑のチェックをタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 모드입니다. 손가락으로 캔버스를 옮긴 뒤 초록 체크 표시를 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在处于相机模式。用手指拖动画布，然后点击绿色对勾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在處於相機模式。用手指拖動畫布，然後點一下綠色勾號。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera modundasın. Tuvali parmağınla taşı, ardından yeşil onay işaretine dokun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś w trybie kamery. Przesuń płótno palcem i stuknij zielony znacznik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent in de cameramodus. Verschuif het canvas met je vinger en tik op het groene vinkje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är i kameraläge. Flytta duken med fingret och tryck på den gröna bocken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er i kameratilstand. Flyt lærredet med fingeren og tryk på det grønne flueben."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er i kameramodus. Flytt lerretet med fingeren og trykk på det grønne merket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet kameratilassa. Siirrä piirtoaluetta sormella ja napauta vihreää valintamerkkiä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda berada dalam mode kamera. Seret untuk memindahkan kanvas, lalu ketuk tanda centang hijau."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ở chế độ camera. Kéo để di chuyển khung vẽ, rồi chạm dấu tích xanh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยู่ในโหมดกล้อง ลากเพื่อเลื่อนผืนผ้าใบ แล้วแตะเครื่องหมายถูกสีเขียว"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви в режимі камери. Перетягніть полотно пальцем і натисніть зелену галочку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste v režimu kamery. Tažením posuňte plátno a pak klepněte na zelené zatržítko."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameramódban vagy. Húzással mozgasd a vásznat, majd koppints a zöld pipára."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε στη λειτουργία κάμερας. Σύρετε για να μετακινήσετε τον καμβά και πατήστε το πράσινο σημάδι επιλογής."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתם במצב מצלמה. גררו כדי להזיז את משטח הציור, ואז הקישו על סימן האישור הירוק."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está no modo de câmara. Arraste a tela e toque no visto verde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está no modo de câmera. Arraste para mover a tela e toque na marca de seleção verde."
          }
        }
      }
    },
    "Try Undo and Redo at the bottom. Use these buttons twice in total.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Undo and Redo at the bottom. Use these buttons twice in total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуй кнопки отмены и повтора внизу экрана. Нажми их в общей сложности два раза."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie Annuler et Rétablir en bas. Utilise ces boutons deux fois au total."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere unten Rückgängig und Wiederholen aus. Benutze die Tasten insgesamt zweimal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Annulla e Ripristina in basso. Usa questi pulsanti due volte in totale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba Deshacer y Rehacer abajo. Usa estos botones dos veces en total."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب التراجع والإعادة في الأسفل. استخدم الزرين مرتين إجمالًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の取り消しとやり直しを試しましょう。合計2回使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래의 실행 취소와 다시 실행을 써보세요. 두 버튼을 합쳐 두 번 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试底部的撤销和重做按钮，总共使用两次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試試底部的還原和重做按鈕，總共使用兩次。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alttaki Geri al ve Yinele düğmelerini toplam iki kez kullan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj Cofnij i Ponów na dole. Użyj tych przycisków łącznie dwa razy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer onderaan Ongedaan maken en Opnieuw. Gebruik de knoppen in totaal twee keer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Ångra och Gör om längst ner. Använd knapparna totalt två gånger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv Fortryd og Gentag nederst. Brug knapperne to gange i alt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv Angre og Gjør om nederst. Bruk knappene totalt to ganger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile alhaalta Kumoa ja Tee uudelleen. Käytä painikkeita yhteensä kahdesti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba Urungkan dan Ulangi di bawah. Gunakan tombol-tombol ini sebanyak dua kali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử Hoàn tác và Làm lại ở dưới. Dùng các nút này tổng cộng hai lần."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองปุ่มเลิกทำและทำซ้ำด้านล่าง ใช้ปุ่มเหล่านี้รวมสองครั้ง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте кнопки «Скасувати» та «Повторити» внизу. Натисніть їх загалом двічі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyzkoušejte dole tlačítka Zpět a Znovu. Použijte je celkem dvakrát."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbáld ki alul a Visszavonás és az Újra gombot. Összesen kétszer használd őket."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε Αναίρεση και Επανάληψη στο κάτω μέρος. Χρησιμοποιήστε τα κουμπιά συνολικά δύο φορές."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסו את ״ביטול פעולה״ ו״ביצוע חוזר״ למטה. השתמשו בכפתורים פעמיים בסך הכול."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente Desfazer e Refazer em baixo. Use estes botões duas vezes no total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente Desfazer e Refazer na parte inferior. Use esses botões duas vezes no total."
          }
        }
      }
    },
    "Save your drawing with the button in the lower-right corner. It goes into the temporary tutorial gallery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your drawing with the button in the lower-right corner. It goes into the temporary tutorial gallery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохрани рисунок кнопкой в правом нижнем углу. Он попадёт во временную учебную галерею."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ton dessin avec le bouton en bas à droite. Il rejoint la galerie temporaire du tutoriel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere die Zeichnung mit der Taste unten rechts in der vorübergehenden Übungsgalerie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il disegno con il pulsante in basso a destra nella galleria temporanea del tutorial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el dibujo con el botón inferior derecho en la galería temporal del tutorial."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ الرسم بالزر الأسفل في معرض التدريب المؤقت."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右下の保存ボタンをタップします。作品は練習用の一時ギャラリーに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 아래 저장 버튼을 누르세요. 그림은 임시 연습 갤러리에 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击右下角保存。作品会保存到临时练习画廊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下右下角儲存。作品會儲存到臨時練習圖庫。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ alttaki düğmeyle çizimini geçici eğitim galerisine kaydet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz rysunek przyciskiem w prawym dolnym rogu w tymczasowej galerii samouczka."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla je tekening met de knop rechtsonder op in de tijdelijke oefengalerij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara teckningen med knappen nere till höger i guidens tillfälliga galleri."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem tegningen med knappen nederst til højre i vejledningens midlertidige galleri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre tegningen med knappen nederst til høyre i omvisningens midlertidige galleri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna piirros oikean alakulman painikkeella opastuksen väliaikaiseen galleriaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan gambar dengan tombol di kanan bawah. Gambar masuk ke galeri tutorial sementara."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu tranh bằng nút ở góc dưới bên phải. Tranh được đưa vào bộ sưu tập hướng dẫn tạm thời."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกภาพด้วยปุ่มที่มุมขวาล่าง ภาพจะอยู่ในแกลเลอรีบทสอนชั่วคราว"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть малюнок кнопкою праворуч унизу. Він потрапить до тимчасової навчальної галереї."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte kresbu tlačítkem vpravo dole. Uloží se do dočasné výukové galerie."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd a rajzot a jobb alsó gombbal. Az ideiglenes gyakorlógalériába kerül."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε το σχέδιο με το κουμπί κάτω δεξιά. Θα μπει στην προσωρινή συλλογή εκμάθησης."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו את הציור באמצעות כפתור השמירה למטה. הוא יתווסף לגלריית ההדרכה הזמנית."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o desenho com o botão inferior direito na galeria temporária do tutorial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve seu desenho com o botão no canto inferior direito. Ele vai para a galeria temporária do tutorial."
          }
        }
      }
    },
    "Share offers the options available on your watch. You can try sharing, then close this page with the cross to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share offers the options available on your watch. You can try sharing, then close this page with the cross to continue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В меню «Поделиться» доступны способы отправки, которые поддерживают твои часы. Можешь попробовать отправить рисунок, затем закрой эту страницу крестиком."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager propose les options disponibles sur ta montre. Tu peux les essayer, puis fermer cette page avec la croix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen zeigt die Optionen deiner Watch. Probiere sie aus oder schließe diese Seite mit dem Kreuz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi offre le opzioni disponibili sull’orologio. Puoi provarle, poi chiudere questa pagina con la croce."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir ofrece las opciones disponibles en tu reloj. Puedes probarlas y después cerrar esta página con la cruz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض المشاركة الخيارات المتاحة على ساعتك. يمكنك تجربتها ثم إغلاق الصفحة بعلامة الإغلاق."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有には時計で利用できる方法が表示されます。試してから×でページを閉じましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유에는 시계에서 사용할 수 있는 방법이 표시됩니다. 사용해 본 뒤 닫기 버튼으로 페이지를 닫으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“分享”会显示手表支持的方式。你可以试用，然后点击叉号关闭页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「分享」會顯示手錶支援的方式。你可以試用，然後以叉號關閉頁面。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaş, saatinde kullanılabilen seçenekleri sunar. Deneyebilir, ardından sayfayı çarpıyla kapatabilirsin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij pokazuje opcje dostępne na zegarku. Możesz je wypróbować, a potem zamknąć stronę krzyżykiem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delen toont de opties op je horloge. Je kunt ze proberen en daarna deze pagina met het kruisje sluiten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela visar alternativen på din klocka. Du kan prova dem och sedan stänga sidan med krysset."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del viser mulighederne på dit ur. Du kan prøve dem og derefter lukke siden med krydset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del viser alternativene på klokken. Du kan prøve dem og deretter lukke siden med krysset."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa näyttää kellosi tarjoamat vaihtoehdot. Voit kokeilla niitä ja sulkea sitten sivun rististä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan menampilkan pilihan yang tersedia di jam Anda. Anda boleh mencoba berbagi, lalu tutup halaman ini dengan tanda silang untuk melanjutkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ hiển thị các lựa chọn có trên đồng hồ của bạn. Bạn có thể thử chia sẻ, rồi đóng trang bằng dấu nhân để tiếp tục."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์จะแสดงตัวเลือกที่มีในนาฬิกาของคุณ คุณลองแชร์ได้ แล้วปิดหน้านี้ด้วยกากบาทเพื่อดำเนินการต่อ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню «Поділитися» пропонує доступні на годиннику способи надсилання. Можете спробувати надіслати малюнок, а потім закрийте сторінку хрестиком."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení nabízí možnosti dostupné na vašich hodinkách. Můžete si sdílení vyzkoušet a pak stránku zavřít křížkem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Megosztás az órádon elérhető lehetőségeket mutatja. Kipróbálhatod, majd a folytatáshoz zárd be az oldalt az X-szel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Κοινοποίηση εμφανίζει τις διαθέσιμες επιλογές στο ρολόι σας. Μπορείτε να τη δοκιμάσετε και μετά να κλείσετε τη σελίδα με το Χ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״שיתוף״ מציג את האפשרויות הזמינות בשעון. אפשר לנסות לשתף, ואז לסגור את העמוד באמצעות ה-X כדי להמשיך."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilhar oferece as opções disponíveis no relógio. Pode experimentá-las e depois fechar esta página com a cruz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhar oferece as opções disponíveis no seu relógio. Você pode experimentar e depois fechar esta página com o X para continuar."
          }
        }
      }
    },
    "Tap the three dots at the top left, then choose Gallery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the three dots at the top left, then choose Gallery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми три точки слева вверху и выбери «Галерея»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche les trois points en haut à gauche, puis Galerie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben links auf die drei Punkte und wähle Galerie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca i tre puntini in alto a sinistra, poi Galleria."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca los tres puntos arriba a la izquierda y elige Galería."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط النقاط الثلاث الأعلى ثم اختر المعرض."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上の3点ボタンをタップし、「ギャラリー」を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 위 점 세 개를 누르고 갤러리를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击左上角的三个点，选择“画廊”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下左上角的三個點，選擇「圖庫」。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol üstteki üç noktaya dokun ve Galeri’yi seç."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij trzy kropki w lewym górnym rogu i wybierz Galeria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik linksboven op de drie puntjes en kies Galerij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på de tre punkterna uppe till vänster och välj Galleri."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på de tre prikker øverst til venstre og vælg Galleri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på de tre prikkene øverst til venstre og velg Galleri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta vasemman yläkulman kolmea pistettä ja valitse Galleria."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tiga titik di kiri atas, lalu pilih Galeri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm ba chấm ở góc trên bên trái, rồi chọn Bộ sưu tập."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสามจุดที่มุมซ้ายบน แล้วเลือกแกลเลอรี"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть три крапки ліворуч угорі й виберіть «Галерея»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na tři tečky vlevo nahoře a vyberte Galerii."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a három pontra balra fent, majd válaszd a Galériát."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε τις τρεις τελείες πάνω αριστερά και επιλέξτε Συλλογή."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על שלוש הנקודות בחלק העליון ובחרו ״גלריה״."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nos três pontos no canto superior esquerdo e escolha Galeria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nos três pontos no canto superior esquerdo e escolha Galeria."
          }
        }
      }
    },
    "These are practice pictures. Turn the Digital Crown or tap a picture twice to open it at full size.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are practice pictures. Turn the Digital Crown or tap a picture twice to open it at full size."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это учебные рисунки. Поверни колёсико или дважды нажми на рисунок, чтобы открыть его в полном размере."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont des images d’entraînement. Tourne la Digital Crown ou touche deux fois une image pour l’ouvrir en plein format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind Übungsbilder. Drehe die Digital Crown oder tippe zweimal auf ein Bild, um es in voller Größe zu öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi sono disegni di prova. Ruota la Digital Crown o tocca due volte un disegno per aprirlo a grandezza intera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son imágenes de práctica. Gira la Digital Crown o toca una imagen dos veces para abrirla a tamaño completo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه صور للتدريب. أدر Digital Crown أو اضغط الصورة مرتين لفتحها بالحجم الكامل."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習用の画像です。Digital Crownを回すか画像を2回タップして、フルサイズで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습용 그림입니다. Digital Crown을 돌리거나 그림을 두 번 눌러 전체 크기로 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是练习图片。转动数码表冠或点击图片两次，以完整尺寸打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是練習圖片。轉動數位錶冠或點圖片兩次，以完整尺寸開啟。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar alıştırma resimleri. Digital Crown’u çevir veya bir resme iki kez dokunarak tam boyutta aç."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To obrazy do ćwiczeń. Obróć Digital Crown lub stuknij obraz dwa razy, aby otworzyć go w pełnym rozmiarze."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn oefenafbeeldingen. Draai de Digital Crown of tik twee keer op een afbeelding om deze op volledig formaat te openen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är övningsbilder. Vrid på Digital Crown eller tryck två gånger på en bild för att öppna den i full storlek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er øvebilleder. Drej Digital Crown eller tryk to gange på et billede for at åbne det i fuld størrelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er øvingsbilder. Vri Digital Crown eller trykk to ganger på et bilde for å åpne det i full størrelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä ovat harjoituskuvia. Kierrä Digital Crownia tai napauta kuvaa kahdesti avataksesi sen täysikokoisena."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah gambar latihan. Putar Digital Crown atau ketuk gambar dua kali untuk membukanya dalam ukuran penuh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là các ảnh thực hành. Xoay Digital Crown hoặc chạm ảnh hai lần để mở ở kích thước đầy đủ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือภาพฝึกหัด หมุน Digital Crown หรือแตะภาพสองครั้งเพื่อเปิดแบบเต็มขนาด"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це навчальні малюнки. Поверніть Digital Crown або двічі натисніть малюнок, щоб відкрити його в повному розмірі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto jsou cvičné obrázky. Otáčením Digital Crown nebo dvojím klepnutím otevřete obrázek v plné velikosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek gyakorlóképek. Forgasd a Digital Crownt, vagy koppints kétszer egy képre a teljes méretű nézethez."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές είναι εικόνες εξάσκησης. Περιστρέψτε το Digital Crown ή πατήστε μια εικόνα δύο φορές για πλήρες μέγεθος."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אלו תמונות לתרגול. סובבו את ה-Digital Crown או הקישו פעמיים על תמונה כדי לפתוח אותה בגודל מלא."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são imagens de treino. Rode a Digital Crown ou toque duas vezes numa imagem para a abrir em tamanho completo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são imagens de prática. Gire a Digital Crown ou toque duas vezes em uma imagem para abri-la em tamanho completo."
          }
        }
      }
    },
    "Use the back button at the top left until you return to the canvas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the back button at the top left until you return to the canvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимай кнопку «Назад» слева вверху, пока не вернёшься к холсту."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le bouton Retour en haut à gauche jusqu’à retrouver la toile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben links auf Zurück, bis du wieder auf der Leinwand bist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Indietro in alto a sinistra finché non torni alla tela."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Atrás arriba a la izquierda hasta volver al lienzo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم زر الرجوع الأعلى حتى تعود إلى اللوحة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上の戻るボタンでキャンバスまで戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 위 뒤로 버튼을 눌러 캔버스로 돌아가세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用左上角的返回按钮，直到回到画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用左上角的返回按鈕，直到回到畫布。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol üstteki Geri düğmesiyle tuvale dön."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj przycisku Wstecz w lewym górnym rogu, aż wrócisz do płótna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik linksboven Terug totdat je weer op het canvas bent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd Tillbaka uppe till vänster tills du återvänder till duken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug Tilbage øverst til venstre, indtil du er tilbage på lærredet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk Tilbake øverst til venstre til du kommer tilbake til lerretet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaa piirtoalueelle vasemman yläkulman Takaisin-painikkeella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan tombol kembali di kiri atas hingga Anda kembali ke kanvas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng nút quay lại ở góc trên bên trái cho đến khi về khung vẽ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปุ่มย้อนกลับที่มุมซ้ายบนจนกลับถึงผืนผ้าใบ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натискайте «Назад» ліворуч угорі, доки не повернетеся до полотна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používejte tlačítko Zpět vlevo nahoře, dokud se nevrátíte na plátno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bal felső Vissza gombbal térj vissza a vászonhoz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε το κουμπί Πίσω πάνω αριστερά μέχρι να επιστρέψετε στον καμβά."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו בכפתור החזרה בחלק העליון עד שתחזרו למשטח הציור."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Voltar no canto superior esquerdo até regressar à tela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o botão Voltar no canto superior esquerdo até retornar à tela."
          }
        }
      }
    },
    "Tap the broom in the lower-left corner and confirm to clear the practice canvas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the broom in the lower-left corner and confirm to clear the practice canvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми метлу слева внизу и подтверди очистку учебного холста."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le balai en bas à gauche et confirme pour effacer la toile d’entraînement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe unten links auf den Besen und bestätige, um die Übungsleinwand zu leeren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la scopa in basso a sinistra e conferma per svuotare la tela di prova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la escoba abajo a la izquierda y confirma para borrar el lienzo de práctica."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط المكنسة الأسفل وأكّد لمسح لوحة التدريب."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左下のほうきをタップし、練習用キャンバスの消去を確定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 아래 빗자루를 누르고 연습 캔버스 지우기를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击左下角的扫帚，并确认清空练习画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下左下角的掃帚，並確認清除練習畫布。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol alttaki süpürgeye dokun ve alıştırma tuvalini temizlemeyi onayla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij miotłę w lewym dolnym rogu i potwierdź wyczyszczenie płótna do ćwiczeń."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik linksonder op de bezem en bevestig om het oefencanvas te wissen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på kvasten nere till vänster och bekräfta för att rensa övningsduken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på kosten nederst til venstre og bekræft for at rydde øvelærredet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på kosten nederst til venstre og bekreft for å tømme øvingslerretet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta vasemman alakulman luutaa ja vahvista harjoitusalueen tyhjennys."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk sapu di kiri bawah dan konfirmasi untuk membersihkan kanvas latihan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm chổi ở góc dưới bên trái và xác nhận để xóa khung vẽ thực hành."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะไม้กวาดที่มุมซ้ายล่าง แล้วยืนยันเพื่อล้างผืนผ้าใบฝึกหัด"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть мітлу ліворуч унизу та підтвердьте очищення навчального полотна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na koště vlevo dole a potvrďte vymazání cvičného plátna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints balra lent a seprűre, és erősítsd meg a gyakorlóvászon törlését."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε τη σκούπα κάτω αριστερά και επιβεβαιώστε τον καθαρισμό του καμβά εξάσκησης."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על המטאטא למטה ואשרו את ניקוי משטח התרגול."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na vassoura no canto inferior esquerdo e confirme para limpar a tela de treino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na vassoura no canto inferior esquerdo e confirme para limpar a tela de prática."
          }
        }
      }
    },
    "Well done! Your own canvas and gallery will return. To repeat the tour, tap the three dots and choose Tutorial.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well done! Your own canvas and gallery will return. To repeat the tour, tap the three dots and choose Tutorial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отлично, обучение завершено! Сейчас вернутся твой холст и галерея. Чтобы повторить, нажми три точки и выбери «Обучение»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bravo ! Ta toile et ta galerie vont revenir. Pour recommencer, touche les trois points, puis Tutoriel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschafft! Deine Leinwand und Galerie kommen zurück. Zum Wiederholen tippe auf die drei Punkte und wähle Einführung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo! Torneranno la tua tela e la tua galleria. Per ripetere, tocca i tre puntini e scegli Tutorial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Muy bien! Volverán tu lienzo y tu galería. Para repetir, toca los tres puntos y elige Tutorial."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحسنت! ستعود لوحتك ومعرضك. لإعادة التدريب، اضغط النقاط الثلاث ثم اختر التدريب."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お疲れさまでした！自分のキャンバスとギャラリーに戻ります。もう一度試すには3点ボタンから「チュートリアル」を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘하셨습니다! 원래 캔버스와 갤러리로 돌아갑니다. 다시 배우려면 점 세 개에서 튜토리얼을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成啦！现在将返回你自己的画布和画廊。想再练习时，点击三个点并选择“教程”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成了！現在將返回你自己的畫布和圖庫。想再練習時，點三個點並選擇「教學」。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tebrikler! Kendi tuvalin ve galerin geri gelecek. Tekrarlamak için üç noktadan Eğitim’i seç."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brawo! Twoje płótno i galeria powrócą. Aby powtórzyć, stuknij trzy kropki i wybierz Samouczek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goed gedaan! Je eigen canvas en galerij komen terug. Kies via de drie puntjes Rondleiding om opnieuw te oefenen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra gjort! Din egen duk och ditt galleri kommer tillbaka. Välj Guide via de tre punkterna för att öva igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godt klaret! Dit eget lærred og galleri vender tilbage. Vælg Vejledning via de tre prikker for at prøve igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra jobbet! Ditt eget lerret og galleri kommer tilbake. Velg Omvisning via de tre prikkene for å prøve igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hienoa! Oma piirtoalueesi ja galleriasi palaavat. Voit kerrata valitsemalla kolmen pisteen valikosta Opastus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagus! Kanvas dan galeri pribadi Anda akan kembali. Untuk mengulang, ketuk tiga titik lalu pilih Tutorial."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rất tốt! Khung vẽ và bộ sưu tập của bạn sẽ trở lại. Để học lại, chạm ba chấm rồi chọn Hướng dẫn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เยี่ยมมาก! ผืนผ้าใบและแกลเลอรีของคุณจะกลับมา หากต้องการเรียนอีกครั้ง ให้แตะสามจุดแล้วเลือกบทสอน"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чудово! Зараз повернуться ваше полотно й галерея. Щоб повторити навчання, натисніть три крапки та виберіть «Навчання»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výborně! Vrátí se vaše vlastní plátno a galerie. Pro zopakování klepněte na tři tečky a vyberte Výuku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ügyes vagy! Visszatér a saját vásznad és galériád. Az ismétléshez koppints a három pontra, majd válaszd a Bemutatót."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπράβο! Θα επιστρέψουν ο δικός σας καμβάς και η συλλογή. Για επανάληψη, πατήστε τις τρεις τελείες και επιλέξτε Εκμάθηση."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הכבוד! משטח הציור והגלריה האישיים שלכם יחזרו כעת. כדי לתרגל שוב, הקישו על שלוש הנקודות ובחרו ״הדרכה״."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Muito bem! A sua tela e galeria vão regressar. Para repetir, toque nos três pontos e escolha Tutorial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muito bem! Sua tela e galeria pessoais vão voltar. Para repetir, toque nos três pontos e escolha Tutorial."
          }
        }
      }
    },
