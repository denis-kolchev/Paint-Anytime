    "Let's try another brush. Tap the tool button in the upper-right corner." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لنجرب فرشاة أخرى. اضغط زر الأداة الأعلى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyzkoušejme jiný štětec. Klepněte na tlačítko nástroje vpravo nahoře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv en anden pensel. Tryk på værktøjsknappen øverst til højre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probiere einen anderen Pinsel: Tippe oben rechts auf die Werkzeugtaste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ας δοκιμάσουμε άλλο πινέλο. Πατήστε το κουμπί εργαλείου πάνω δεξιά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let's try another brush. Tap the tool button in the upper-right corner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba otro pincel: toca el botón de herramienta arriba a la derecha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokeile toista sivellintä. Napauta työkalupainiketta oikeassa yläkulmassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essaie un autre pinceau : touche le bouton de l’outil en haut à droite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ננסה מברשת אחרת. הקישו על כפתור הכלי בחלק העליון."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próbáljunk ki másik ecsetet! Koppints az eszköz gombjára a jobb felső sarokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mari mencoba kuas lain. Ketuk tombol alat di kanan atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova un altro pennello: tocca il pulsante dello strumento in alto a destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のブラシを試しましょう。右上のツールボタンをタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 브러시를 써볼까요? 오른쪽 위 도구 버튼을 누르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv en annen pensel. Trykk på verktøyknappen øverst til høyre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer een andere kwast. Tik rechtsboven op de gereedschapsknop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wypróbuj inny pędzel. Stuknij przycisk narzędzia w prawym górnym rogu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos experimentar outro pincel. Toque no botão da ferramenta no canto superior direito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente outro pincel: toque no botão da ferramenta no canto superior direito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Давай попробуем другую кисть. Нажми на кнопку инструмента в правом верхнем углу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova en annan pensel. Tryck på verktygsknappen uppe till höger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองใช้แปรงอื่นกัน แตะปุ่มเครื่องมือที่มุมขวาบน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
