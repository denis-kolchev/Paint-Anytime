    "Blend chart: yellow passes increase to the right; blue passes increase downward." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخطط المزج: تزداد التمريرات الصفراء نحو اليمين والزرقاء نحو الأسفل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulka míchání: doprava přibývají žluté tahy, dolů modré."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blandingsskema: flere gule strøg mod højre, flere blå strøg nedad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mischtabelle: Nach rechts mehr gelbe, nach unten mehr blaue Aufträge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πίνακας ανάμειξης: οι κίτρινες περασιές αυξάνονται δεξιά και οι μπλε προς τα κάτω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blend chart: yellow passes increase to the right; blue passes increase downward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabla de mezcla: las pasadas amarillas aumentan hacia la derecha y las azules hacia abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekoitustaulukko: keltaiset vedot lisääntyvät oikealle, siniset alaspäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tableau de mélange : les passages jaunes augmentent vers la droite, les bleus vers le bas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טבלת מיזוג: מספר המעברים הצהובים גדל ימינה, והכחולים כלפי מטה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keverési táblázat: jobbra a sárga, lefelé a kék ecsetvonások száma nő."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagan campuran: sapuan kuning bertambah ke kanan, sapuan biru bertambah ke bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabella di fusione: le passate gialle aumentano verso destra, quelle blu verso il basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合成表：右に進むほど黄色の重ね塗りが増え、下に進むほど青が増えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혼합표: 오른쪽으로 갈수록 노란색 덧칠이, 아래로 갈수록 파란색 덧칠이 늘어납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blandingsskjema: flere gule strøk mot høyre, flere blå strøk nedover."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengschema: meer gele streken naar rechts, meer blauwe streken naar beneden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabela mieszania: w prawo przybywa żółtych pociągnięć, w dół — niebieskich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabela de mistura: as passadas amarelas aumentam à direita e as azuis para baixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabela de mistura: as passagens amarelas aumentam para a direita e as azuis para baixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таблица смешивания: число жёлтых мазков растёт вправо, синих — вниз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blandningsschema: fler gula drag åt höger, fler blå drag nedåt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตารางผสมสี: จำนวนครั้งที่ทาสีเหลืองเพิ่มไปทางขวา และสีน้ำเงินเพิ่มลงด้านล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karışım tablosu: sarı geçişler sağa, mavi geçişler aşağıya doğru artar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таблиця змішування: кількість жовтих проходів зростає праворуч, синіх — униз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng hòa trộn: số lượt tô vàng tăng sang phải, lượt tô xanh lam tăng xuống dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混合表：向右增加黄色涂画次数，向下增加蓝色涂画次数。"
          }
