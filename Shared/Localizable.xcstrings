            "state": "translated",
            "value": "एकसमान मोटाई की चिकनी रेखा बनाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna una linea uniforme di spessore costante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一定の太さで滑らかな線を描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
