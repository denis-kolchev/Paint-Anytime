          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse vihreä kiertämällä Digital Crownia tai napauttamalla viereisiä värejä."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हरा रंग चुनने के लिए Digital Crown घुमाएँ या पास वाले रंग पर टैप करें।"
