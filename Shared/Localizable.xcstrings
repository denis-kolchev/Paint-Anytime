          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritar en jämn linje med konstant tjocklek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegner en jævn linje med konstant tykkelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegner en jevn linje med konstant tykkelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirtää tasaisen viivan, jonka paksuus pysyy samana."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே தடிமனில் மென்மையான கோட்டை வரைகிறது."
          }
        },
        "te": {
