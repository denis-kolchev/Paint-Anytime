    "Applies to new marker and watercolor strokes. Hybrid is the default." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطبّق على ضربات قلم التحديد والألوان المائية الجديدة. الوضع المختلط هو الافتراضي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pro nové tahy fixem a akvarelem. Výchozí režim je Hybridní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder nye tusch- og akvarelstrøg. Hybrid er standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für neue Marker- und Aquarellstriche. Hybrid ist die Standardeinstellung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει για νέες πινελιές μαρκαδόρου και ακουαρέλας. Προεπιλογή είναι η Υβριδική."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to new marker and watercolor strokes. Hybrid is the default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a los nuevos trazos de rotulador y acuarela. Híbrido es el modo predeterminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
