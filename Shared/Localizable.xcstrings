    "Open Width, then turn the Crown." : {
      "comment" : "Tutorial instruction or accessibility text. Keep concise for Apple Watch. Directional gestures mirror in right-to-left languages.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح «السُمك»، ثم أدر Crown."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete „Tloušťka“ a otočte Crown."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn ”Tykkelse”, og drej på Crown."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne „Breite“ und drehe die Crown."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε το «Πάχος» και στρέψτε το Crown."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Width, then turn the Crown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre «Grosor» y gira la Crown."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa ”Paksuus” ja käännä Crownia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez « Épaisseur », puis tournez la Crown."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתחו את ״עובי״ וסובבו את ה-Crown."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyisd meg a „Vastagság” elemet, majd forgasd a Crownt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka “Ketebalan”, lalu putar Crown."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri «Spessore» e ruota la Crown."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「太さ」を開いてCrownを回します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘두께’를 열고 Crown을 돌리세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne «Tykkelse» og vri på Crown."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open ‘Dikte’ en draai aan de Crown."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz „Grubość” i obróć Crown."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra “Espessura” e gire a Crown."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra «Espessura» e rode a Crown."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте «Толщина» и вращайте Crown."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna ”Tjocklek” och vrid på Crown."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิด “ความหนา” แล้วหมุน Crown"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Kalınlık” bölümünü açıp Crown’u çevir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте «Товщина» й обертайте Crown."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở “Độ dày”, rồi xoay Crown."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“粗细”，然后转动 Crown。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「粗細」，然後轉動 Crown。"
          }
        }
      }
    },
