    "Draws a smooth line with a constant width.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draws a smooth line with a constant width."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисует ровную линию постоянной толщины."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسم خطًا ناعمًا بسُمك ثابت."
