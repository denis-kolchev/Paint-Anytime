        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேல் இடப்புற மூன்று புள்ளிகளைத் தட்டி கேலரியைத் தேர்வுசெய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎగువ ఎడమ మూలలో మూడు చుక్కలు నొక్కి గ్యాలరీ ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वर डावीकडील तीन ठिपके दाबून गॅलरी निवडा."
