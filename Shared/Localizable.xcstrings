    "A flat calligraphy nib creates sharp edges. Adjust its angle on the Angle page." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ سن الخط المسطح حواف واضحة. اضبط زاويته في صفحة الزاوية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plochý kaligrafický hrot vytváří ostré okraje. Jeho sklon nastavíte na stránce Úhel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En flad kalligrafispids skaber skarpe kanter. Juster hældningen på siden Vinkel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine flache Kalligrafiefeder erzeugt scharfe Kanten. Passe ihre Neigung auf der Seite Winkel an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επίπεδη καλλιγραφική μύτη δημιουργεί αιχμηρές άκρες. Ρυθμίστε την κλίση της στη σελίδα Γωνία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A flat calligraphy nib creates sharp edges. Adjust its angle on the Angle page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una punta caligráfica plana crea bordes definidos. Ajusta su inclinación en la página Ángulo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Litteä kalligrafiakärki tekee terävät reunat. Säädä sen kallistusta Kulma-sivulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une plume calligraphique plate crée des bords nets. Réglez son inclinaison sur la page Angle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חוד קליגרפי שטוח יוצר קצוות חדים. כוונו את הנטייה שלו בעמוד הזווית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lapos kalligráfiahegy éles széleket készít. A dőlését a Szög oldalon állíthatod be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujung kaligrafi datar membuat tepi yang tegas. Sesuaikan kemiringannya di halaman Sudut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pennino calligrafico piatto crea bordi netti. Regola l’inclinazione nella pagina Angolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平らなカリグラフィーのペン先が、くっきりした輪郭を描きます。「角度」ページで傾きを調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평평한 캘리그래피 펜촉이 선명한 가장자리를 만듭니다. 각도 페이지에서 기울기를 조절하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En flat kalligrafispiss lager skarpe kanter. Juster helningen på siden Vinkel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een platte kalligrafiepunt maakt scherpe randen. Pas de helling aan op de pagina Hoek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płaska stalówka kaligraficzna tworzy ostre krawędzie. Dostosuj jej nachylenie na stronie Kąt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ponta de caligrafia plana cria bordas nítidas. Ajuste a inclinação na página Ângulo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ponta de caligrafia plana cria contornos nítidos. Ajuste a inclinação na página Ângulo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плоское каллиграфическое перо создаёт чёткие края. Его наклон можно настроить на странице «Угол»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En platt kalligrafispets skapar skarpa kanter. Justera lutningen på sidan Vinkel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปลายปากกาคัดลายมือแบบแบนสร้างขอบคมชัด ปรับความเอียงได้ที่หน้า มุม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düz hat ucu keskin kenarlar oluşturur. Eğimini Açı sayfasından ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плоский каліграфічний наконечник створює чіткі краї. Налаштуйте нахил у розділі «Кут»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngòi thư pháp phẳng tạo cạnh sắc nét. Điều chỉnh độ nghiêng trên trang Góc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扁平的书法笔尖形成清晰边缘。可在“角度”页面调整笔尖倾斜角度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扁平的書法筆尖形成清晰邊緣。可在「角度」頁面調整筆尖傾斜角度。"
          }
        }
      }
    },
    "A rounded calligraphy nib varies line width with stroke direction." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر سن الخط المستدير سُمك الخط حسب اتجاه الحركة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaoblený kaligrafický hrot mění tloušťku čáry podle směru tahu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En afrundet kalligrafispids varierer linjens tykkelse efter stregens retning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine abgerundete Kalligrafiefeder verändert die Linienbreite je nach Strichrichtung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η στρογγυλεμένη καλλιγραφική μύτη αλλάζει το πάχος ανάλογα με την κατεύθυνση της πινελιάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rounded calligraphy nib varies line width with stroke direction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una punta caligráfica redondeada varía el grosor según la dirección del trazo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyöristetty kalligrafiakärki muuttaa viivan paksuutta piirtosuunnan mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une plume calligraphique arrondie fait varier l’épaisseur selon la direction du trait."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חוד קליגרפי מעוגל משנה את עובי הקו בהתאם לכיוון המשיכה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lekerekített kalligráfiahegy a vonás irányától függően változtatja a vonal vastagságát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujung kaligrafi membulat mengubah ketebalan garis sesuai arah goresan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pennino calligrafico arrotondato varia lo spessore in base alla direzione del tratto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丸みのあるカリグラフィーのペン先が、描く方向に応じて線の太さを変えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둥근 캘리그래피 펜촉이 그리는 방향에 따라 선의 두께를 바꿉니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En avrundet kalligrafispiss varierer linjetykkelsen etter strekens retning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een afgeronde kalligrafiepunt verandert de lijndikte afhankelijk van de tekenrichting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaokrąglona stalówka kaligraficzna zmienia grubość linii zależnie od kierunku kreski."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ponta de caligrafia arredondada varia a espessura da linha conforme a direção do traço."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ponta de caligrafia arredondada varia a espessura conforme a direção do traço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скруглённое каллиграфическое перо меняет толщину линии в зависимости от направления движения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rundad kalligrafispets varierar linjens tjocklek efter streckets riktning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปลายปากกาคัดลายมือแบบมนเปลี่ยนความหนาของเส้นตามทิศทางการวาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuvarlatılmış hat ucu, çizgi yönüne göre kalınlığı değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Округлий каліграфічний наконечник змінює товщину лінії залежно від напрямку штриха."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngòi thư pháp bo tròn thay đổi độ dày theo hướng nét vẽ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圆润的书法笔尖会随绘画方向改变线条粗细。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圓潤的書法筆尖會隨繪畫方向改變線條粗細。"
          }
        }
      }
    },
