          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta vasemman yläkulman kolmea pistettä ja valitse Galleria."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर बाईं ओर तीन बिंदु दबाएँ, फिर गैलरी चुनें।"
