    "Swipe left or tap Width at the bottom to open the width setting.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left or tap Width at the bottom to open the width setting."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведи пальцем справа налево или нажми «Толщина» внизу, чтобы открыть настройку толщины."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaye vers la gauche ou touche Épaisseur en bas pour ouvrir ce réglage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach links oder tippe unten auf Breite, um die Einstellung zu öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri verso sinistra o tocca Spessore in basso per aprire l’impostazione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia la izquierda o toca Grosor abajo para abrir el ajuste."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a esquerda ou toque em Espessura em baixo para abrir a definição."
