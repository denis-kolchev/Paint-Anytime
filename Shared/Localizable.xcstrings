        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سبز رنگ منتخب کرنے کے لیے Digital Crown گھمائیں یا ساتھ والے رنگ کو تھپتھپائیں۔"
          }
        },
        "vi": {
