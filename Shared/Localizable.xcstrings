          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Leinwandbild konnte nicht gespeichert werden. Versuche es erneut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैनवास का चित्र सहेजा नहीं जा सका। फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l’immagine della tela. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスの画像を保存できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스 이미지를 저장할 수 없습니다. 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a imagem da tela. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存画布图像。请重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la imagen del lienzo. Inténtalo de nuevo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuval görüntüsü kaydedilemedi. Tekrar deneyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存畫布影像。請再試一次。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać obrazu płótna. Spróbuj ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De canvasafbeelding kon niet worden opgeslagen. Probeer het opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte spara bilden av duken. Försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet af lærredet kunne ikke gemmes. Prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lagre bildet av lerretet. Prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirtoalueen kuvaa ei voitu tallentaa. Yritä uudelleen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரைதளப் படத்தைச் சேமிக்க முடியவில்லை. மீண்டும் முயலவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్వాస్ చిత్రాన్ని సేవ్ చేయలేకపోయాము. మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅनव्हासची प्रतिमा जतन करता आली नाही. पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૅનવાસની છબી સાચવી શકાઈ નથી. ફરી પ્રયાસ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਨਵਸ ਦੀ ਤਸਵੀਰ ਸੰਭਾਲੀ ਨਹੀਂ ਜਾ ਸਕੀ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যানভাসের ছবি সেভ করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan gambar kanvas. Coba lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کینوس کی تصویر محفوظ نہیں ہو سکی۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu hình ảnh khung vẽ. Vui lòng thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกภาพผืนผ้าใบได้ โปรดลองอีกครั้ง"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej kanvas tidak dapat disimpan. Cuba lagi."
          }
        }
      }
    },
