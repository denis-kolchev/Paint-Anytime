          "stringUnit": {
            "state": "translated",
            "value": "కాన్వాస్ చిత్రాన్ని సేవ్ చేయలేకపోయాము. మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅनव्हासची प्रतिमा जतन करता आली नाही. पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૅનવાસની છબી સાચવી શકાઈ નથી. ફરી પ્રયાસ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਨਵਸ ਦੀ ਤਸਵੀਰ ਸੰਭਾਲੀ ਨਹੀਂ ਜਾ ਸਕੀ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যানভাসের ছবি সেভ করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan gambar kanvas. Coba lagi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کینوس کی تصویر محفوظ نہیں ہو سکی۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu hình ảnh khung vẽ. Vui lòng thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกภาพผืนผ้าใบได้ โปรดลองอีกครั้ง"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej kanvas tidak dapat disimpan. Cuba lagi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти зображення полотна. Спробуйте ще раз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázek plátna se nepodařilo uložit. Zkuste to znovu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginea pânzei nu a putut fi salvată. Încearcă din nou."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült menteni a vászon képét. Próbáld újra."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποθήκευση της εικόνας του καμβά. Δοκιμάστε ξανά."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשמור את תמונת משטח הציור. נסו שוב."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázok plátna sa nepodarilo uložiť. Skúste to znova."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće spremiti sliku platna. Pokušajte ponovno."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slike platna ni bilo mogoče shraniti. Poskusite znova."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut desar la imatge del llenç. Torna-ho a provar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a imagem da tela. Tente novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a imagem da tela. Tente novamente."
          }
        }
      }
    },
