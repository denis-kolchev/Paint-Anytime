    "Draw slowly for thicker lines and quickly for thinner lines.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw slowly for thicker lines and quickly for thinner lines."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При медленном движении линия толще, при быстром — тоньше."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم ببطء لخطوط أكثر سُمكًا وبسرعة لخطوط أرفع."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez lentement pour un trait épais et rapidement pour un trait fin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne langsam für dickere und schnell für dünnere Linien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोटी रेखाओं के लिए धीरे और पतली रेखाओं के लिए तेज़ी से बनाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna lentamente per linee spesse e velocemente per linee sottili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり描くと太く、速く描くと細くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 그리면 굵게, 빠르게 그리면 가늘게 그려집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe devagar para linhas mais grossas e depressa para linhas mais finas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢画时线条较粗，快画时线条较细。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja despacio para líneas más gruesas y rápido para líneas más finas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalın çizgiler için yavaş, ince çizgiler için hızlı çizin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢畫時線條較粗，快畫時線條較細。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rysuj wolno, aby uzyskać grubsze linie, i szybko, aby uzyskać cieńsze."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teken langzaam voor dikkere lijnen en snel voor dunnere lijnen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita långsamt för tjockare linjer och snabbt för tunnare linjer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn langsomt for tykkere linjer og hurtigt for tyndere linjer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn sakte for tykkere linjer og raskt for tynnere linjer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirrä hitaasti saadaksesi paksumpia ja nopeasti saadaksesi ohuempia viivoja."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தடிமனான கோடுகளுக்கு மெதுவாகவும், மெல்லிய கோடுகளுக்கு வேகமாகவும் வரையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మందమైన గీతల కోసం నెమ్మదిగా, సన్నని గీతల కోసం వేగంగా గీయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जाड रेषांसाठी हळू आणि बारीक रेषांसाठी वेगाने रेखाटा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જાડી રેખાઓ માટે ધીમે અને પાતળી રેખાઓ માટે ઝડપથી દોરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੋਟੀਆਂ ਲਕੀਰਾਂ ਲਈ ਹੌਲੀ ਅਤੇ ਪਤਲੀਆਂ ਲਕੀਰਾਂ ਲਈ ਤੇਜ਼ੀ ਨਾਲ ਬਣਾਓ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মোটা রেখার জন্য ধীরে এবং সরু রেখার জন্য দ্রুত আঁকুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar perlahan untuk garis lebih tebal dan cepat untuk garis lebih tipis."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موٹی لکیروں کے لیے آہستہ اور باریک لکیروں کے لیے تیزی سے بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ chậm để có nét dày hơn và vẽ nhanh để có nét mảnh hơn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาดช้าเพื่อให้เส้นหนาขึ้น และวาดเร็วเพื่อให้เส้นบางลง"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukis perlahan untuk garisan lebih tebal dan pantas untuk garisan lebih nipis."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Малюйте повільно для товстих ліній і швидко для тонких."
          }
        },
        "cs": {
