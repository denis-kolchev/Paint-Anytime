    "Sets the flat nib angle. The angle changes the stroke shape and width as you draw in different directions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط زاوية السن المسطح. تغيّر الزاوية شكل الخط وعرضه بحسب اتجاه الرسم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavuje úhel plochého hrotu. Úhel mění tvar a šířku tahu podle směru kreslení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstiller den flade penspids vinkel. Vinklen ændrer stregens form og bredde afhængigt af tegneretningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt den Winkel der flachen Feder fest. Der Winkel verändert Form und Breite des Strichs je nach Zeichenrichtung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίζει τη γωνία της επίπεδης μύτης. Η γωνία αλλάζει το σχήμα και το πάχος της γραμμής ανάλογα με την κατεύθυνση σχεδίασης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sets the flat nib angle. The angle changes the stroke shape and width as you draw in different directions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define el ángulo de la plumilla plana. El ángulo cambia la forma y el grosor del trazo según la dirección del dibujo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Määrittää litteän kärjen kulman. Kulma muuttaa viivan muotoa ja leveyttä piirustussuunnan mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règle l’angle de la plume plate. Cet angle modifie la forme et la largeur du trait selon la direction du dessin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובע את זווית הציפורן השטוחה. הזווית משנה את צורת הקו ואת עוביו בהתאם לכיוון הציור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítja a lapos tollhegy szögét. A szög a rajzolás irányától függően módosítja a vonal alakját és vastagságát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengatur sudut mata pena datar. Sudut mengubah bentuk dan lebar goresan sesuai arah menggambar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta l’angolo del pennino piatto. L’angolo cambia la forma e lo spessore del tratto in base alla direzione del disegno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平たいペン先の角度を設定します。角度によって、描く方向に応じた線の形や太さが変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "납작한 펜촉의 각도를 설정합니다. 각도에 따라 그리는 방향별 선의 모양과 두께가 달라집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angir vinkelen på den flate pennespissen. Vinkelen endrer strekens form og bredde avhengig av tegneretningen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt de hoek van de platte penpunt in. De hoek verandert de vorm en breedte van de lijn afhankelijk van de tekenrichting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia kąt płaskiej stalówki. Kąt zmienia kształt i grubość kreski zależnie od kierunku rysowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o ângulo da ponta plana. O ângulo altera a forma e a espessura do traço conforme a direção do desenho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o ângulo da ponta plana. O ângulo altera a forma e a espessura do traço conforme a direção do desenho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт угол плоского пера. От угла зависят форма и толщина штриха при рисовании в разных направлениях."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställer in den platta spetsens vinkel. Vinkeln ändrar linjens form och bredd beroende på ritriktning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดมุมของหัวปากกาแบน มุมจะเปลี่ยนรูปทรงและความกว้างของเส้นตามทิศทางที่วาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düz kalem ucunun açısını ayarlar. Açı, çizim yönüne göre çizginin şeklini ve kalınlığını değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задає кут плоского пера. Кут змінює форму й товщину штриха залежно від напрямку малювання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt góc ngòi bút dẹt. Góc này thay đổi hình dạng và độ rộng nét theo hướng vẽ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置扁平笔尖的角度。角度会影响不同绘画方向下笔画的形状和宽度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定扁平筆尖的角度。角度會影響不同繪畫方向下筆畫的形狀和寬度。"
          }
        }
      }
    },
