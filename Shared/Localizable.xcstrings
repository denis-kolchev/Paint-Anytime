        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskúšajme iný štetec. Klepnite na tlačidlo nástroja vpravo hore."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
