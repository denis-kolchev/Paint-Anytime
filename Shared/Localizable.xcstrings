        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaş, saatinde kullanılabilen seçenekleri sunar. Deneyebilir, ardından sayfayı çarpıyla kapatabilirsin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij pokazuje opcje dostępne na zegarku. Możesz je wypróbować, a potem zamknąć stronę krzyżykiem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delen toont de opties op je horloge. Je kunt ze proberen en daarna deze pagina met het kruisje sluiten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela visar alternativen på din klocka. Du kan prova dem och sedan stänga sidan med krysset."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del viser mulighederne på dit ur. Du kan prøve dem og derefter lukke siden med krydset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del viser alternativene på klokken. Du kan prøve dem og deretter lukke siden med krysset."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa näyttää kellosi tarjoamat vaihtoehdot. Voit kokeilla niitä ja sulkea sitten sivun rististä."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साझा करें में आपकी घड़ी पर उपलब्ध विकल्प दिखते हैं। साझा करना आज़मा सकते हैं, फिर आगे बढ़ने के लिए क्रॉस से पृष्ठ बंद करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பகிர் பகுதியில் உங்கள் கடிகாரத்தில் கிடைக்கும் வழிகள் உள்ளன. பகிர முயற்சித்த பின், தொடர குறுக்குக்குறியால் இந்தப் பக்கத்தை மூடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "షేర్‌లో మీ వాచ్‌లో అందుబాటులో ఉన్న ఎంపికలు ఉంటాయి. షేర్ చేయడం ప్రయత్నించి, కొనసాగడానికి క్రాస్‌తో ఈ పేజీ మూసివేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शेअरमध्ये तुमच्या घड्याळावरील उपलब्ध पर्याय दिसतात. शेअर करून पाहा, मग पुढे जाण्यासाठी फुलीने पान बंद करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શેરમાં તમારી ઘડિયાળ પર ઉપલબ્ધ વિકલ્પો દેખાય છે. શેર કરવાનું અજમાવી શકો છો, પછી આગળ વધવા ચોકડીથી પાનું બંધ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਂਝਾ ਕਰੋ ਵਿੱਚ ਤੁਹਾਡੀ ਘੜੀ ਉੱਤੇ ਉਪਲਬਧ ਵਿਕਲਪ ਹਨ। ਸਾਂਝਾ ਕਰਨਾ ਅਜ਼ਮਾ ਕੇ, ਅੱਗੇ ਜਾਣ ਲਈ ਕਰਾਸ ਨਾਲ ਪੰਨਾ ਬੰਦ ਕਰੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেয়ার-এ আপনার ঘড়িতে উপলব্ধ বিকল্পগুলো আছে। শেয়ার করা চেষ্টা করে, এগোতে ক্রস দিয়ে পৃষ্ঠা বন্ধ করুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan menampilkan pilihan yang tersedia di jam Anda. Anda boleh mencoba berbagi, lalu tutup halaman ini dengan tanda silang untuk melanjutkan."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شیئر میں آپ کی گھڑی پر دستیاب طریقے نظر آتے ہیں۔ شیئر کرنا آزما سکتے ہیں، پھر آگے بڑھنے کے لیے کراس سے صفحہ بند کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ hiển thị các lựa chọn có trên đồng hồ của bạn. Bạn có thể thử chia sẻ, rồi đóng trang bằng dấu nhân để tiếp tục."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์จะแสดงตัวเลือกที่มีในนาฬิกาของคุณ คุณลองแชร์ได้ แล้วปิดหน้านี้ด้วยกากบาทเพื่อดำเนินการต่อ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kongsi memaparkan pilihan yang tersedia pada jam anda. Anda boleh mencuba perkongsian, kemudian tutup halaman ini dengan tanda pangkah untuk meneruskan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню «Поділитися» пропонує доступні на годиннику способи надсилання. Можете спробувати надіслати малюнок, а потім закрийте сторінку хрестиком."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení nabízí možnosti dostupné na vašich hodinkách. Můžete si sdílení vyzkoušet a pak stránku zavřít křížkem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajează oferă opțiunile disponibile pe ceas. Poți încerca partajarea, apoi închide pagina cu X pentru a continua."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Megosztás az órádon elérhető lehetőségeket mutatja. Kipróbálhatod, majd a folytatáshoz zárd be az oldalt az X-szel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Κοινοποίηση εμφανίζει τις διαθέσιμες επιλογές στο ρολόι σας. Μπορείτε να τη δοκιμάσετε και μετά να κλείσετε τη σελίδα με το Χ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״שיתוף״ מציג את האפשרויות הזמינות בשעון. אפשר לנסות לשתף, ואז לסגור את העמוד באמצעות ה-X כדי להמשיך."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľanie ponúka možnosti dostupné na hodinkách. Môžete ho vyskúšať a potom stránku zavrieť krížikom."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeljenje nudi mogućnosti dostupne na vašem satu. Možete ga isprobati, a zatim zatvorite stranicu križićem za nastavak."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deljenje ponuja možnosti, ki so na voljo v vaši uri. Lahko jih preizkusite, nato zaprite stran s križcem za nadaljevanje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparteix ofereix les opcions disponibles al rellotge. Pots provar de compartir i després tancar la pàgina amb la creu per continuar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilhar oferece as opções disponíveis no relógio. Pode experimentá-las e depois fechar esta página com a cruz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhar oferece as opções disponíveis no seu relógio. Você pode experimentar e depois fechar esta página com o X para continuar."
          }
        }
      }
    },
    "Tap the three dots at the top left, then choose Gallery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
