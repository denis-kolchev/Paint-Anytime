    "Deepen rich colored shadows and add gritty contrast. Dark brush colors can quickly crush detail to black. Use low opacity over existing paint; pure white stays white." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deepen rich colored shadows and add gritty contrast. Dark brush colors can quickly crush detail to black. Use low opacity over existing paint; opaque white paint stays white."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Углубляйте насыщенные цветные тени и добавляйте жёсткий контраст. Тёмная кисть быстро уводит детали в чёрный. Работайте с небольшой прозрачностью по готовому цвету; непрозрачная белая краска остаётся белой."
          }
        }
      }
    },
