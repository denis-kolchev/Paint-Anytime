        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujung kaligrafi membulat mengubah ketebalan garis sesuai arah goresan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngòi thư pháp bo tròn thay đổi độ dày theo hướng nét vẽ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลายปากกาคัดลายมือแบบมนเปลี่ยนความหนาของเส้นตามทิศทางการวาด"
