    "For privacy questions or requests, contact Denis Kolchev at paintanytime.app@gmail.com (mailto:paintanytime.app@gmail.com)." : {
      "comment" : "Privacy policy, paragraph 22 of 22. Keep meaning aligned with docs/PRIVACY.md; preserve URLs and contact details.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للأسئلة أو الطلبات المتعلقة بالخصوصية، تواصل مع Denis Kolchev على paintanytime.app@gmail.com (mailto:paintanytime.app@gmail.com)."
          }
        },
