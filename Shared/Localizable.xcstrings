    "Paint colored shadows, deepen folds, or tint a sketch while keeping dark lines visible. Each pass darkens the underlying colors. White has no effect; many passes can make shadows muddy." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paint colored shadows, deepen folds, or tint a sketch while keeping dark lines visible. Each pass darkens the underlying colors. White has no effect; many passes can make shadows muddy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисуйте цветные тени, углубляйте складки и тонируйте скетч, сохраняя тёмные линии. Каждый проход затемняет нижние цвета. Белый не меняет рисунок; слишком много проходов могут сделать тени грязными."
          }
        }
      }
    },
    "Paint dramatic light and strong colored shadows. Light brush colors brighten; dark brush colors deepen the image. Useful for bold lighting accents; lower opacity for more control." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paint dramatic light and strong colored shadows. Light brush colors brighten; dark brush colors deepen the image. Useful for bold lighting accents; lower opacity for more control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисуйте выразительный свет и насыщенные цветные тени. Светлые цвета кисти осветляют рисунок, тёмные — затемняют. Подходит для резких световых акцентов; меньшая прозрачность даёт больше контроля."
          }
        }
      }
    },
