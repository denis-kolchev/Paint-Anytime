    "Your drawing is being sent to Photos on iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your drawing is being sent to Photos on iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисунок отправляется в Фото на iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ إرسال رسمك إلى تطبيق الصور على iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dessin est en cours d’envoi vers Photos sur l’iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zeichnung wird an Fotos auf dem iPhone gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disegno viene inviato a Foto su iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画をiPhoneの「写真」に送信しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림을 iPhone의 사진 앱으로 보내는 중입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在将画作发送到 iPhone 上的“照片”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dibujo se está enviando a Fotos en el iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çiziminiz iPhone’daki Fotoğraflar’a gönderiliyor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在將畫作傳送至 iPhone 上的「照片」。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rysunek jest wysyłany do Zdjęć na iPhonie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tekening wordt naar Foto’s op de iPhone gestuurd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din teckning skickas till Bilder på iPhone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din tegning sendes til Fotos på iPhone."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegningen din sendes til Bilder på iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirrostasi lähetetään iPhonen Kuvat-appiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar Anda sedang dikirim ke Foto di iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản vẽ của bạn đang được gửi đến Ảnh trên iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังส่งภาพวาดของคุณไปยังแอปรูปภาพบน iPhone"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш малюнок надсилається до «Фотографій» на iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kresba se odesílá do Fotek na iPhonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rajz küldése folyamatban az iPhone Fotók alkalmazásába."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σχέδιό σας αποστέλλεται στις Φωτογραφίες του iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הציור נשלח ליישום ״תמונות״ ב-iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenho está a ser enviado para Fotografias no iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu desenho está sendo enviado para o app Fotos no iPhone."
          }
        }
      }
    },
    "Your drawing is saved on your watch. Open the iPhone app to send it to Photos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your drawing is saved on your watch. Open the iPhone app to send it to Photos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисунок сохранён на часах. Для отправки в Фото откройте приложение на iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ رسمك على الساعة. افتح تطبيق iPhone لإرساله إلى الصور."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dessin est enregistré sur votre montre. Ouvrez l’app iPhone pour l’envoyer vers Photos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zeichnung ist auf der Watch gespeichert. Öffne die iPhone-App, um sie an Fotos zu senden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disegno è salvato sull’orologio. Apri l’app per iPhone per inviarlo a Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画は時計に保存されています。「写真」に送信するにはiPhoneアプリを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림이 시계에 저장되었습니다. 사진 앱으로 보내려면 iPhone 앱을 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画作已保存在手表上。打开 iPhone App 以将其发送到“照片”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dibujo está guardado en el reloj. Abre la app del iPhone para enviarlo a Fotos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çiziminiz saatinize kaydedildi. Fotoğraflar’a göndermek için iPhone uygulamasını açın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫作已儲存在手錶上。開啟 iPhone App 以將其傳送至「照片」。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rysunek jest zapisany na zegarku. Otwórz aplikację na iPhonie, aby wysłać go do Zdjęć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tekening is op je horloge opgeslagen. Open de iPhone-app om deze naar Foto’s te sturen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din teckning är sparad på klockan. Öppna iPhone-appen för att skicka den till Bilder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din tegning er gemt på uret. Åbn iPhone-appen for at sende den til Fotos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegningen din er lagret på klokken. Åpne iPhone-appen for å sende den til Bilder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirroksesi on tallennettu kelloon. Avaa iPhone-appi lähettääksesi sen Kuvat-appiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar Anda disimpan di jam. Buka app iPhone untuk mengirimnya ke Foto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản vẽ của bạn đã được lưu trên đồng hồ. Mở ứng dụng iPhone để gửi đến Ảnh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพวาดของคุณบันทึกอยู่บนนาฬิกา เปิดแอป iPhone เพื่อส่งไปยังแอปรูปภาพ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Малюнок збережено на годиннику. Відкрийте застосунок на iPhone, щоб надіслати його до «Фотографій»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kresba je uložená na hodinkách. Otevřete aplikaci na iPhonu a odešlete ji do Fotek."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rajz az órán van mentve. Nyisd meg az iPhone-alkalmazást, hogy elküldhesd a Fotókba."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σχέδιο αποθηκεύτηκε στο ρολόι. Ανοίξτε την εφαρμογή iPhone για αποστολή στις Φωτογραφίες."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הציור נשמר בשעון. פתחו את היישום ב-iPhone כדי לשלוח אותו ל״תמונות״."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenho está guardado no relógio. Abra a app para iPhone para o enviar para Fotografias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu desenho está salvo no relógio. Abra o app no iPhone para enviá-lo ao Fotos."
          }
        }
      }
    },
