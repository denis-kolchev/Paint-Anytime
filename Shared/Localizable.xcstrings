    "You can start the tutorial anytime: tap the three dots, then Tutorial.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start the tutorial anytime: tap the three dots, then Tutorial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение можно пройти в любой момент: нажмите три точки и выберите «Обучение»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez lancer le tutoriel à tout moment : touchez les trois points, puis Tutoriel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Einführung jederzeit starten: Tippe auf die drei Punkte und dann auf Einführung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi avviare il tutorial in qualsiasi momento: tocca i tre puntini, poi Tutorial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes iniciar el tutorial cuando quieras: toca los tres puntos y luego Tutorial."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode iniciar o tutorial a qualquer momento: toque nos três pontos e depois em Tutorial."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك بدء التدريب في أي وقت: اضغط على النقاط الثلاث، ثم التدريب."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも3つの点をタップし、「チュートリアル」を選ぶと練習できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든지 점 세 개를 누르고 튜토리얼을 선택하면 시작할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以开始教程：轻点三个点，然后选择“教程”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時可以開始教學：點一下三個點，然後選擇「教學」。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğitimi istediğiniz zaman başlatabilirsiniz: üç noktaya dokunun, ardından Eğitim seçeneğini seçin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samouczek możesz uruchomić w każdej chwili: stuknij trzy kropki, a potem Samouczek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de rondleiding altijd starten: tik op de drie stippen en kies Rondleiding."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan starta guiden när som helst: tryck på de tre punkterna och välj Guide."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan starte vejledningen når som helst: tryk på de tre prikker, og vælg Vejledning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan starte omvisningen når som helst: trykk på de tre prikkene og velg Omvisning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit aloittaa opastuksen milloin tahansa: napauta kolmea pistettä ja valitse Opastus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कभी भी प्रशिक्षण शुरू कर सकते हैं: तीन बिंदु दबाएँ, फिर प्रशिक्षण चुनें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எப்போது வேண்டுமானாலும் பயிற்சியைத் தொடங்கலாம்: மூன்று புள்ளிகளைத் தட்டி பயிற்சியைத் தேர்வுசெய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎప్పుడైనా శిక్షణ ప్రారంభించవచ్చు: మూడు చుక్కలు నొక్కి శిక్షణ ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही कधीही प्रशिक्षण सुरू करू शकता: तीन ठिपके दाबा आणि प्रशिक्षण निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ગમે ત્યારે તાલીમ શરૂ કરી શકો છો: ત્રણ બિંદુ દબાવી તાલીમ પસંદ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਕਦੇ ਵੀ ਸਿਖਲਾਈ ਸ਼ੁਰੂ ਕਰ ਸਕਦੇ ਹੋ: ਤਿੰਨ ਬਿੰਦੀਆਂ ਦਬਾ ਕੇ ਸਿਖਲਾਈ ਚੁਣੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো সময় প্রশিক্ষণ শুরু করতে পারেন: তিনটি বিন্দু চেপে প্রশিক্ষণ বেছে নিন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda bisa memulai tutorial kapan saja: ketuk tiga titik, lalu Tutorial."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کسی بھی وقت تربیت شروع کر سکتے ہیں: تین نقطے دبائیں، پھر تربیت منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể bắt đầu hướng dẫn bất cứ lúc nào: chạm ba chấm, rồi chọn Hướng dẫn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเริ่มบทสอนได้ทุกเมื่อ โดยแตะสามจุดแล้วเลือกบทสอน"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh memulakan tutorial pada bila-bila masa: ketik tiga titik, kemudian Tutorial."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навчання доступне будь-коли: натисніть три крапки й виберіть «Навчання»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výuku můžete kdykoli spustit: klepněte na tři tečky a pak na Výuku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți începe tutorialul oricând: atinge cele trei puncte, apoi Tutorial."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor elindíthatod a bemutatót: koppints a három pontra, majd a Bemutatóra."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να ξεκινήσετε την εκμάθηση οποτεδήποτε: πατήστε τις τρεις τελείες και μετά Εκμάθηση."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להתחיל את ההדרכה בכל עת: הקישו על שלוש הנקודות ובחרו ״הדרכה״."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výučbu môžete kedykoľvek spustiť: klepnite na tri bodky a potom na Výučbu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodič možete pokrenuti bilo kada: dodirnite tri točke pa Vodič."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodič lahko zaženete kadar koli: tapnite tri pike in nato Vodič."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots iniciar el tutorial en qualsevol moment: toca els tres punts i després Tutorial."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode iniciar o tutorial a qualquer momento: toque nos três pontos e depois em Tutorial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode iniciar o tutorial a qualquer momento: toque nos três pontos e depois em Tutorial."
          }
        }
      }
    },
