    "When you are ready, tap Next.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you are ready, tap Next."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда будешь готов(а), нажми «Далее»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous êtes prêt, touchez Suivant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du bereit bist, tippe auf Weiter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sei pronto, tocca Avanti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando estés listo, toca Siguiente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تكون جاهزًا، اضغط على التالي."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備ができたら「次へ」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비되면 다음을 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好后，请轻点“下一步”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備好後，請點一下「下一步」。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır olduğunuzda İleri seçeneğine dokunun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy będziesz gotowy, stuknij Dalej."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Volgende als je klaar bent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Nästa när du är redo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Næste, når du er klar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Neste når du er klar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun olet valmis, napauta Seuraava."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat siap, ketuk Berikutnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi sẵn sàng, hãy chạm Tiếp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อพร้อมแล้ว ให้แตะถัดไป"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли будете готові, натисніть «Далі»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až budete připraveni, klepněte na Další."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha készen állsz, koppints a Tovább gombra."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είστε έτοιμοι, πατήστε Επόμενο."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשתהיו מוכנים, הקישו על ״הבא״."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando estiver pronto, toque em Seguinte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando estiver pronto, toque em Próximo."
          }
        }
      }
    },
