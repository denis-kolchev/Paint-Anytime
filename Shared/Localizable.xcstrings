          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekee rakeisen viivan, jonka tekstuuri on lyijykynää tiheämpi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un trait granuleux à la texture plus dense que le crayon."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יוצר משיכה גרגירית בעלת מרקם צפוף יותר מעיפרון."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szemcsés vonást készít a ceruzánál sűrűbb textúrával."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat goresan berbutir dengan tekstur lebih padat daripada pensil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un tratto granuloso con una trama più densa della matita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鉛筆よりも密な質感のある、粒状の線を描きます。"
          }
        },
        "ko" : {
