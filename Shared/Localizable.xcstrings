          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa ”Kulma” ja käännä Crownia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez « Angle », puis tournez la Crown."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתחו את ״זווית״ וסובבו את ה-Crown."
