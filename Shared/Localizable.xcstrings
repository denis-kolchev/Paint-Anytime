          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para preencher uma área contígua com a cor e a opacidade escolhidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para preencher uma área contígua com a cor e a opacidade escolhidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь связной области, чтобы залить её выбранным цветом с заданной плотностью."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att fylla ett sammanhängande område med vald färg och opacitet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะเพื่อเติมพื้นที่ที่เชื่อมต่อกันด้วยสีและความทึบที่เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitişik bir alanı seçilen renk ve opaklıkla doldurmak için dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться, щоб залити зв’язну область вибраним кольором із заданою непрозорістю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm để tô vùng liền nhau bằng màu và độ đục đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点以使用所选颜色和不透明度填充相连区域。"
