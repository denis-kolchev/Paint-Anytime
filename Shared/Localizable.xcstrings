        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lekerekített kalligráfiahegy a vonás irányától függően változtatja a vonal vastagságát."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η στρογγυλεμένη καλλιγραφική μύτη αλλάζει το πάχος ανάλογα με την κατεύθυνση της πινελιάς."
