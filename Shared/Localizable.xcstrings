          }
        }
      }
    },
    "Create intense glow, hot highlights, and luminous edges over existing color. Bright brush colors quickly push highlights toward white. Use low opacity; the effect is invisible over white." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create intense glow, hot highlights, and luminous edges over existing color. Bright brush colors quickly push highlights toward white. Use low opacity; the effect is invisible over opaque white paint."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавайте яркое свечение, горячие блики и светящиеся края поверх цвета. Светлая кисть быстро выбеливает блики. Используйте небольшую прозрачность; поверх непрозрачной белой краски эффект не виден."
          }
        }
      }
    },
    "Create softer inverted colors and muted graphic effects. Similar to Difference with gentler contrast. Black has no effect; white inverts the image. Try it for stylized color shifts." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create softer inverted colors and muted graphic effects. Similar to Difference with gentler contrast. Black has no effect; white inverts the image. Try it for stylized color shifts."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавайте мягкую инверсию и приглушённые графические эффекты. Похож на разницу, но с меньшим контрастом. Чёрный не влияет на результат, белый инвертирует рисунок. Подходит для стилизованных цветовых сдвигов."
          }
        }
      }
    },
    "Creates a grainy stroke with a denser texture than the pencil." : {
