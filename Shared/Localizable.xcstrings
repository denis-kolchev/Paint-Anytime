          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaokrąglona stalówka kaligraficzna zmienia grubość linii zależnie od kierunku kreski."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een afgeronde kalligrafiepunt verandert de lijndikte afhankelijk van de tekenrichting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En rundad kalligrafispets varierar linjens tjocklek efter streckets riktning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En afrundet kalligrafispids varierer linjens tykkelse efter stregens retning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En avrundet kalligrafispiss varierer linjetykkelsen etter strekens retning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyöristetty kalligrafiakärki muuttaa viivan paksuutta piirtosuunnan mukaan."
