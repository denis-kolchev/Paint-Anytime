        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튜토리얼을 종료하시겠습니까?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que quer terminar o tutorial?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要结束教程吗？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres terminar el tutorial?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğitimi bitirmek istediğinizden emin misiniz?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要結束教學嗎？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz zakończyć samouczek?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je de rondleiding wilt beëindigen?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du verkligen avsluta guiden?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil afslutte vejledningen?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil avslutte omvisningen?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko varmasti lopettaa opastuksen?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயிற்சியை முடிக்க விரும்புகிறீர்களா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఖచ్చితంగా శిక్షణను ముగించాలనుకుంటున్నారా?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला नक्की प्रशिक्षण समाप्त करायचे आहे का?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમે ખરેખર તાલીમ સમાપ્ત કરવા માંગો છો?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਸੀਂ ਸੱਚਮੁੱਚ ਸਿਖਲਾਈ ਸਮਾਪਤ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি নিশ্চিতভাবে প্রশিক্ষণ শেষ করতে চান?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakin ingin mengakhiri tutorial?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا آپ واقعی تربیت ختم کرنا چاہتے ہیں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc muốn kết thúc hướng dẫn không?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าต้องการจบบทสอน"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah anda pasti mahu menamatkan tutorial?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете завершити навчання?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravdu chcete ukončit výuku?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur dorești să închei tutorialul?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosan befejezed a bemutatót?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε σίγουρα να τερματίσετε την εκμάθηση;"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם אתם בטוחים שברצונכם לסיים את ההדרכה?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naozaj chcete ukončiť výučbu?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Želite li zaista završiti vodič?"
          }
        },
        "sl": {
