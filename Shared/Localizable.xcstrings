    "Creates soft, translucent strokes. Layer strokes to deepen the color.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates soft, translucent strokes. Layer strokes to deepen the color."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт мягкие полупрозрачные штрихи. Накладывайте их друг на друга, чтобы сделать цвет насыщеннее."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ خطوطًا ناعمة شبه شفافة. راكم الخطوط لتعميق اللون."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée des traits doux et translucides. Superposez-les pour intensifier la couleur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeugt weiche, halbtransparente Striche. Durch Überlagern wird die Farbe kräftiger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tratti morbidi e traslucidi. Sovrapponili per intensificare il colore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "柔らかな半透明の線を描きます。線を重ねると色が深まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 반투명 선을 그립니다. 선을 겹쳐 그리면 색이 진해집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制柔和的半透明笔画。叠加笔画可加深颜色。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea trazos suaves y translúcidos. Superponlos para intensificar el color."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumuşak, yarı saydam çizgiler oluşturur. Rengi koyulaştırmak için çizgileri üst üste çizin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製柔和的半透明筆畫。疊加筆畫可加深顏色。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzy miękkie, półprzezroczyste kreski. Nakładaj je, aby pogłębić kolor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt zachte, doorschijnende lijnen. Teken lagen over elkaar om de kleur te verdiepen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapar mjuka, halvgenomskinliga streck. Lägg streck ovanpå varandra för djupare färg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Laver bløde, halvgennemsigtige streger. Læg streger oven på hinanden for en dybere farve."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lager myke, halvgjennomsiktige streker. Legg streker oppå hverandre for en dypere farge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekee pehmeitä, läpikuultavia viivoja. Syvennä väriä piirtämällä viivoja päällekkäin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuat goresan lembut dan tembus pandang. Tumpuk goresan untuk memperdalam warna."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo nét mềm, bán trong suốt. Vẽ chồng các nét để màu đậm hơn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างเส้นนุ่มกึ่งโปร่งใส วาดเส้นซ้อนกันเพื่อให้สีเข้มขึ้น"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створює м’які напівпрозорі штрихи. Накладайте їх, щоб посилити колір."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytváří měkké průsvitné tahy. Vrstvením tahů zvýrazníte barvu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lágy, áttetsző vonásokat készít. Több réteggel mélyítheted a színt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργεί απαλές, ημιδιαφανείς πινελιές. Προσθέστε στρώσεις για εντονότερο χρώμα."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יוצר משיכות רכות ושקופות למחצה. הוסיפו שכבות כדי להעמיק את הצבע."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria traços suaves e translúcidos. Sobreponha-os para intensificar a cor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria traços suaves e translúcidos. Sobreponha os traços para intensificar a cor."
          }
        }
      }
    },
    "Removes marks. Choose Pixel eraser or Object eraser on the Mode page.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes marks. Choose Pixel eraser or Object eraser on the Mode page."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет нарисованное. На странице «Режим» выберите ластик пикселей или ластик объектов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الرسم. اختر ممحاة البكسل أو ممحاة العناصر في صفحة الوضع."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le dessin. Choisissez Gomme de pixels ou Gomme d’objets sur la page Mode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Gezeichnetes. Wähle auf der Seite Modus den Pixel- oder Objektradierer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove i segni. Scegli Gomma pixel o Gomma oggetti nella pagina Modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描いた線を消します。「モード」ページでピクセル消しゴムかオブジェクト消しゴムを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그린 흔적을 지웁니다. 모드 페이지에서 픽셀 지우개 또는 개체 지우개를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "擦除已画内容。在“模式”页面选择像素橡皮擦或对象橡皮擦。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra lo dibujado. Elige Goma de píxeles o Goma de objetos en la página Modo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çizimleri siler. Mod sayfasında Piksel silgisi veya Nesne silgisi seçin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擦除已畫內容。在「模式」頁面選擇像素橡皮擦或物件橡皮擦。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa narysowane kreski. Na stronie Tryb wybierz gumkę pikseli lub obiektów."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumt getekende lijnen uit. Kies Pixelgum of Objectgum op de pagina Modus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort det ritade. Välj pixelsuddgummi eller objektsuddgummi på sidan Läge."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner det tegnede. Vælg pixelviskelæder eller objektviskelæder på siden Tilstand."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner det du har tegnet. Velg pikselviskelær eller objektviskelær på siden Modus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa piirtojälkiä. Valitse Tila-sivulta pikselipyyhekumi tai objektipyyhekumi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus goresan. Pilih Penghapus piksel atau Penghapus objek di halaman Mode."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa nét vẽ. Chọn Tẩy điểm ảnh hoặc Tẩy đối tượng trên trang Chế độ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบรอยที่วาด เลือกยางลบพิกเซลหรือยางลบวัตถุที่หน้า โหมด"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирає малюнок. Виберіть гумку пікселів або об’єктів у розділі «Режим»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraňuje kresbu. Na stránce Režim vyberte pixelovou nebo objektovou gumu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja a rajz részeit. A Mód oldalon válassz pixelradírt vagy objektumradírt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί σημάδια. Επιλέξτε γόμα pixel ή αντικειμένων στη σελίδα Λειτουργία."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק סימנים. בחרו מחק פיקסלים או מחק עצמים בעמוד המצב."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga o desenho. Escolha Borracha de píxeis ou Borracha de objetos na página Modo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove marcas. Escolha Borracha de pixels ou Borracha de objetos na página Modo."
          }
        }
      }
    },
    "Erases only the parts you touch. Width sets the size of the erased area.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases only the parts you touch. Width sets the size of the erased area."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирает только те участки, которых вы касаетесь. Толщина задаёт размер стираемой области."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمحو الأجزاء التي تلمسها فقط. يحدد السُمك حجم المنطقة الممحوة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface uniquement les parties touchées. L’épaisseur définit la taille de la zone effacée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radiert nur die berührten Stellen. Die Breite bestimmt die Größe des radierten Bereichs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella solo le parti toccate. Lo spessore determina le dimensioni dell’area cancellata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "触れた部分だけを消します。太さで消す範囲の大きさを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닿은 부분만 지웁니다. 두께로 지워지는 영역의 크기를 설정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅擦除触碰的部分。粗细设置决定擦除区域的大小。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra solo las partes que tocas. El grosor determina el tamaño del área borrada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca dokunduğunuz kısımları siler. Kalınlık, silinen alanın boyutunu belirler."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只擦除觸碰的部分。粗細設定決定擦除區域的大小。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ściera tylko dotknięte fragmenty. Grubość określa rozmiar ścieranego obszaru."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumt alleen de aangeraakte delen uit. De dikte bepaalt de grootte van het gewiste gebied."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Suddar bara de delar du rör vid. Tjockleken bestämmer storleken på området som suddas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter kun de dele, du rører ved. Tykkelsen bestemmer størrelsen på det slettede område."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Visker bare ut delene du berører. Tykkelsen bestemmer størrelsen på området som viskes ut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkii vain koskettamasi osat. Paksuus määrittää pyyhittävän alueen koon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya menghapus bagian yang disentuh. Ketebalan mengatur ukuran area yang dihapus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xóa phần bạn chạm vào. Độ dày quyết định kích thước vùng bị xóa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบเฉพาะส่วนที่คุณสัมผัส ความหนากำหนดขนาดของพื้นที่ที่ลบ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирає лише ділянки, яких ви торкаєтесь. Товщина визначає розмір ділянки стирання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Maže pouze místa, kterých se dotknete. Tloušťka určuje velikost mazané oblasti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az érintett részeket törli. A vastagság adja meg a törölt terület méretét."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σβήνει μόνο τα σημεία που αγγίζετε. Το πάχος ορίζει το μέγεθος της περιοχής σβησίματος."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק רק את האזורים שבהם נוגעים. העובי קובע את גודל אזור המחיקה."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga apenas as partes em que toca. A espessura define o tamanho da área apagada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga apenas as partes que você toca. A espessura define o tamanho da área apagada."
          }
        }
      }
    },
    "Removes each entire stroke you touch, even if you touch only part of it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes each entire stroke you touch, even if you touch only part of it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет каждый затронутый штрих целиком, даже если коснуться только его части."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل كل خط تلمسه بالكامل، حتى لو لمست جزءًا منه فقط."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime entièrement chaque trait touché, même si vous n’en touchez qu’une partie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt jeden berührten Strich vollständig, auch wenn du nur einen Teil davon berührst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove completamente ogni tratto toccato, anche se ne tocchi solo una parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線の一部に触れるだけで、その線全体を削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선의 일부만 터치해도 해당 선 전체를 지웁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触碰笔画的任意部分，即可删除整个笔画。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina por completo cada trazo que tocas, aunque solo toques una parte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bir kısmına dokunsanız bile dokunduğunuz çizginin tamamını siler."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸碰筆畫的任何部分，即可刪除整個筆畫。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa każdą dotkniętą kreskę w całości, nawet jeśli dotkniesz tylko jej fragmentu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elke aangeraakte lijn volledig, ook als je maar een deel ervan aanraakt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort varje streck du rör vid i sin helhet, även om du bara rör vid en del."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner hver streg, du rører ved, helt, selv hvis du kun rører ved en del af den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner hver strek du berører, i sin helhet, selv om du bare berører en del av den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa koko koskettamasi viivan, vaikka koskettaisit vain osaa siitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus seluruh goresan yang disentuh, meskipun Anda hanya menyentuh sebagian kecilnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa toàn bộ mỗi nét bạn chạm vào, ngay cả khi bạn chỉ chạm một phần của nét đó."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบเส้นที่คุณสัมผัสทั้งเส้น แม้จะสัมผัสเพียงบางส่วนของเส้นก็ตาม"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє весь штрих, якого ви торкаєтесь, навіть якщо торкнутися лише його частини."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní celý tah, kterého se dotknete, i když se dotknete jen jeho části."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljes érintett vonást eltávolítja akkor is, ha csak egy részét érinted meg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί ολόκληρη την πινελιά που αγγίζετε, ακόμη κι αν αγγίξετε μόνο ένα μέρος της."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק כל משיכה שנוגעים בה בשלמותה, גם אם נוגעים רק בחלק ממנה."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove por inteiro cada traço em que toca, mesmo que toque apenas numa parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove por inteiro cada traço que você toca, mesmo que toque apenas em uma parte dele."
          }
        }
      }
    },
    "Welcome to Paint Anytime! Draw two separate strokes in the center of the canvas. Your own drawings are safe during this tutorial.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Paint Anytime! Draw two separate strokes in the center of the canvas. Your own drawings are safe during this tutorial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в Paint Anytime! Нарисуй два отдельных штриха по центру холста. Во время обучения твои собственные рисунки в безопасности."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans Paint Anytime ! Trace deux traits au centre. Tes propres dessins restent en sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei Paint Anytime! Zeichne zwei Striche in der Mitte. Deine eigenen Zeichnungen bleiben sicher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvenuto in Paint Anytime! Disegna due tratti al centro. I tuoi disegni personali sono al sicuro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bienvenido a Paint Anytime! Dibuja dos trazos en el centro. Tus propios dibujos están a salvo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا بك في Paint Anytime! ارسم خطين منفصلين في الوسط. رسوماتك الخاصة آمنة أثناء التدريب."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytimeへようこそ！中央に2本の線を描きましょう。練習中も自分の作品は保護されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytime에 오신 것을 환영합니다! 중앙에 선 두 개를 그려보세요. 기존 그림은 안전하게 보관됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 Paint Anytime！在画布中央画两笔。练习不会影响你自己的作品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎使用 Paint Anytime！在畫布中央畫兩筆。練習不會影響你自己的作品。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytime’a hoş geldin! Ortaya iki ayrı çizgi çiz. Kendi çizimlerin eğitim sırasında güvende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witaj w Paint Anytime! Narysuj dwie osobne kreski na środku. Twoje własne rysunki są bezpieczne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom bij Paint Anytime! Teken twee losse lijnen in het midden. Je eigen tekeningen blijven veilig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välkommen till Paint Anytime! Rita två separata streck i mitten. Dina egna teckningar är säkra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen til Paint Anytime! Tegn to separate streger i midten. Dine egne tegninger er sikre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen til Paint Anytime! Tegn to separate streker i midten. Dine egne tegninger er trygge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tervetuloa Paint Anytimeen! Piirrä keskelle kaksi erillistä viivaa. Omat piirroksesi pysyvät turvassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang di Paint Anytime! Buat dua goresan terpisah di tengah kanvas. Gambar pribadi Anda tetap aman selama tutorial ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng đến với Paint Anytime! Vẽ hai nét riêng biệt ở giữa khung vẽ. Tranh của bạn vẫn an toàn trong bài hướng dẫn này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยินดีต้อนรับสู่ Paint Anytime! วาดเส้นแยกกันสองเส้นตรงกลางผืนผ้าใบ ภาพของคุณจะปลอดภัยระหว่างบทสอนนี้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вітаємо в Paint Anytime! Намалюйте два окремі штрихи в центрі полотна. Ваші власні малюнки в безпеці під час навчання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vítejte v Paint Anytime! Nakreslete dva samostatné tahy uprostřed plátna. Vaše vlastní kresby jsou během výuky v bezpečí."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üdv a Paint Anytime-ban! Rajzolj két külön vonást a vászon közepére. Saját rajzaid biztonságban vannak a bemutató alatt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καλώς ήρθατε στο Paint Anytime! Σχεδιάστε δύο ξεχωριστές πινελιές στο κέντρο του καμβά. Τα δικά σας σχέδια είναι ασφαλή κατά την εκμάθηση."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברוכים הבאים ל-Paint Anytime! ציירו שתי משיכות נפרדות במרכז משטח הציור. הציורים האישיים שלכם בטוחים במהלך ההדרכה."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo ao Paint Anytime! Desenhe dois traços no centro. Os seus desenhos pessoais estão seguros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Boas-vindas ao Paint Anytime! Desenhe dois traços separados no centro da tela. Seus desenhos pessoais estão seguros durante este tutorial."
          }
        }
      }
    },
    "Let's try another brush. Tap the tool button in the upper-right corner.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's try another brush. Tap the tool button in the upper-right corner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
