        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חוד קליגרפי מעוגל משנה את עובי הקו בהתאם לכיוון המשיכה."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ponta de caligrafia arredondada varia a espessura conforme a direção do traço."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ponta de caligrafia arredondada varia a espessura da linha conforme a direção do traço."
          }
        }
      }
    },
    "A flat calligraphy nib creates sharp edges. Adjust its angle on the Angle page.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A flat calligraphy nib creates sharp edges. Adjust its angle on the Angle page."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плоское каллиграфическое перо создаёт чёткие края. Его наклон можно настроить на странице «Угол»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ سن الخط المسطح حواف واضحة. اضبط زاويته في صفحة الزاوية."
          }
        },
        "fr": {
