    "Scroll down to share your drawing, or tap × to close." : {
      "comment" : "Tutorial instruction or accessibility text. Keep concise for Apple Watch. Directional gestures mirror in right-to-left languages.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر لأسفل للمشاركة، أو اضغط × للإغلاق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posuňte dolů pro sdílení nebo klepněte na × pro zavření."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rul ned for at dele, eller tryk på × for at lukke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolle zum Teilen nach unten oder tippe zum Schließen auf ×."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε κύλιση προς τα κάτω για κοινή χρήση ή πατήστε × για κλείσιμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll down to share your drawing, or tap × to close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate hacia abajo para compartir o toca × para cerrar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa vierittämällä alas tai sulje napauttamalla ×."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites défiler vers le bas pour partager, ou touchez × pour fermer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גללו למטה לשיתוף, או הקישו על × לסגירה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görgess le a megosztáshoz, vagy koppints a × jelre a bezáráshoz."
          }
        },
        "id" : {
          "stringUnit" : {
