    "Open the Tool page and select Reed pen using the Digital Crown or the tool list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Tool page and select Reed pen using the Digital Crown or the tool list."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейди в раздел «Инструмент» и выбери «Тростник» колёсиком или нажатием в списке инструментов."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Outil et choisis Calame avec la Digital Crown ou la liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Werkzeug und wähle Rohrfeder mit der Digital Crown oder in der Liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Strumento e scegli Calamo con la Digital Crown o nell’elenco."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Herramienta y elige Cálamo con la Digital Crown o en la lista."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ferramenta e escolha Cálamo com a Digital Crown ou na lista."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الأداة واختر قلم قصب باستخدام Digital Crown أو القائمة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ツール」を開き、Digital Crownか一覧で「葦ペン」を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구를 열고 Digital Crown이나 목록에서 갈대 펜을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“工具”，用数码表冠或列表选择“芦苇笔”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「工具」，用數位錶冠或列表選擇「蘆葦筆」。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç sayfasını aç ve Digital Crown veya listeyle Kamış kalem seç."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Narzędzie i wybierz Pióro trzcinowe za pomocą Digital Crown lub listy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Gereedschap en kies Rietpen met de Digital Crown of de lijst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Verktyg och välj Vasspenna med Digital Crown eller listan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Værktøj og vælg Rørpen med Digital Crown eller listen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Verktøy og velg Rørpenn med Digital Crown eller listen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Työkalu ja valitse Ruokokynä Digital Crownilla tai luettelosta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टूल पृष्ठ खोलें और Digital Crown या टूल सूची से रीड पेन चुनें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கருவிப் பக்கத்தைத் திறந்து Digital Crown அல்லது கருவிப் பட்டியலில் நாணல் பேனாவைத் தேர்வுசெய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సాధనం పేజీ తెరిచి Digital Crown లేదా సాధనాల జాబితాతో రీడ్ పెన్ ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "साधन पान उघडा आणि Digital Crown किंवा साधनांच्या यादीतून रीड पेन निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાધન પાનું ખોલો અને Digital Crown અથવા સાધનોની યાદીથી રીડ પેન પસંદ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੰਦ ਪੰਨਾ ਖੋਲ੍ਹੋ ਅਤੇ Digital Crown ਜਾਂ ਸੰਦਾਂ ਦੀ ਸੂਚੀ ਤੋਂ ਕਾਨੇ ਦੀ ਕਲਮ ਚੁਣੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টুল পৃষ্ঠা খুলে Digital Crown বা টুলের তালিকা থেকে রিড পেন বেছে নিন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka halaman Alat dan pilih Pena buluh melalui Digital Crown atau daftar alat."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹول صفحہ کھولیں اور Digital Crown یا ٹول کی فہرست سے سرکنڈے کا قلم منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở trang Công cụ và chọn Bút sậy bằng Digital Crown hoặc danh sách công cụ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหน้าเครื่องมือ แล้วเลือกปากกาอ้อด้วย Digital Crown หรือรายการเครื่องมือ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka halaman Alat dan pilih Pen buluh melalui Digital Crown atau senarai alat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте розділ «Інструмент» і виберіть «Очеретяне перо» за допомогою Digital Crown або списку інструментів."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete stránku Nástroj a pomocí Digital Crown nebo seznamu nástrojů vyberte Rákosové pero."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide pagina Instrument și alege Pană de trestie folosind Digital Crown sau lista de instrumente."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg az Eszköz oldalt, és válaszd a Nádtollat a Digital Crownnal vagy az eszközlistából."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τη σελίδα Εργαλείο και επιλέξτε Καλαμένια πένα με το Digital Crown ή τη λίστα εργαλείων."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את עמוד ״כלי״ ובחרו ״עט קנה״ באמצעות ה-Digital Crown או רשימת הכלים."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte stránku Nástroj a pomocou Digital Crown alebo zoznamu nástrojov vyberte Trstinové pero."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite stranicu Alat i odaberite Pero od trske pomoću krunice Digital Crown ili popisa alata."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite stran Orodje in s krono Digital Crown ali seznamom orodij izberite Trstično pero."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre la pàgina Eina i selecciona Ploma de canya amb la Digital Crown o la llista d’eines."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ferramenta e escolha Cálamo com a Digital Crown ou na lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a página Ferramenta e escolha Cálamo usando a Digital Crown ou a lista de ferramentas."
          }
        }
      }
    },
    "Tap the information button at the top left. Read about the tool, then close the page with the cross.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the information button at the top left. Read about the tool, then close the page with the cross."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми кнопку информации слева вверху. Прочитай об инструменте, затем закрой описание крестиком."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le bouton d’information en haut à gauche. Lis la description, puis ferme-la avec la croix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben links auf die Infotaste. Lies die Beschreibung und schließe sie mit dem Kreuz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante informazioni in alto a sinistra. Leggi la descrizione e chiudila con la croce."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de información arriba a la izquierda. Lee la descripción y ciérrala con la cruz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de informações no canto superior esquerdo. Leia a descrição e feche-a com a cruz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط زر المعلومات الأعلى. اقرأ الوصف ثم أغلقه بعلامة الإغلاق."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上の情報ボタンをタップします。説明を読んだら×で閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 위 정보 버튼을 누르세요. 설명을 읽고 닫기 버튼으로 닫으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击左上角的信息按钮。阅读说明后，点击叉号关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下左上角的資訊按鈕。閱讀說明後，以叉號關閉。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol üstteki bilgi düğmesine dokun. Açıklamayı oku, sonra çarpıyla kapat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij przycisk informacji w lewym górnym rogu. Przeczytaj opis i zamknij go krzyżykiem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik linksboven op de informatieknop. Lees de uitleg en sluit deze met het kruisje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på informationsknappen uppe till vänster. Läs beskrivningen och stäng den med krysset."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på informationsknappen øverst til venstre. Læs beskrivelsen og luk den med krydset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på informasjonsknappen øverst til venstre. Les beskrivelsen og lukk den med krysset."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta tietopainiketta vasemmassa yläkulmassa. Lue kuvaus ja sulje se rististä."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर बाईं ओर जानकारी बटन दबाएँ। टूल के बारे में पढ़ें, फिर क्रॉस से पृष्ठ बंद करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேல் இடப்புறத் தகவல் பொத்தானைத் தட்டுங்கள். கருவியைப் பற்றிப் படித்து, பின்னர் குறுக்குக்குறியால் பக்கத்தை மூடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎగువ ఎడమవైపు సమాచారం బటన్ నొక్కండి. సాధనం గురించి చదివి క్రాస్ గుర్తుతో పేజీ మూసివేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वर डावीकडील माहिती बटण दाबा. साधनाबद्दल वाचा, मग फुलीने पान बंद करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપર ડાબે માહિતી બટન દબાવો. સાધન વિશે વાંચો, પછી ચોકડીથી પાનું બંધ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉੱਪਰ ਖੱਬੇ ਜਾਣਕਾਰੀ ਬਟਨ ਦਬਾਓ। ਸੰਦ ਬਾਰੇ ਪੜ੍ਹੋ, ਫਿਰ ਕਰਾਸ ਨਾਲ ਪੰਨਾ ਬੰਦ ਕਰੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওপরে বাঁয়ের তথ্য বোতাম চাপুন। টুল সম্পর্কে পড়ুন, তারপর ক্রস দিয়ে পৃষ্ঠা বন্ধ করুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol informasi di kiri atas. Baca penjelasan alat, lalu tutup halaman dengan tanda silang."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوپر معلومات کا بٹن دبائیں۔ ٹول کے بارے میں پڑھیں، پھر کراس سے صفحہ بند کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm nút thông tin ở góc trên bên trái. Đọc về công cụ, rồi đóng trang bằng dấu nhân."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มข้อมูลที่มุมซ้ายบน อ่านข้อมูลเครื่องมือ แล้วปิดหน้าด้วยกากบาท"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik butang maklumat di kiri atas. Baca tentang alat, kemudian tutup halaman dengan tanda pangkah."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку інформації ліворуч угорі. Прочитайте про інструмент і закрийте сторінку хрестиком."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na informační tlačítko vlevo nahoře. Přečtěte si o nástroji a pak stránku zavřete křížkem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge butonul de informații din stânga sus. Citește despre instrument, apoi închide pagina cu semnul X."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints balra fent az információs gombra. Olvass az eszközről, majd zárd be az oldalt az X-szel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το κουμπί πληροφοριών πάνω αριστερά. Διαβάστε για το εργαλείο και κλείστε τη σελίδα με το Χ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על כפתור המידע בחלק העליון. קראו על הכלי וסגרו את העמוד באמצעות ה-X."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na informačné tlačidlo vľavo hore. Prečítajte si o nástroji a potom stránku zavrite krížikom."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite gumb za informacije gore lijevo. Pročitajte o alatu, a zatim zatvorite stranicu križićem."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite gumb za informacije zgoraj levo. Preberite opis orodja, nato zaprite stran s križcem."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botó d’informació a dalt a l’esquerra. Llegeix sobre l’eina i tanca la pàgina amb la creu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de informações no canto superior esquerdo. Leia a descrição e feche-a com a cruz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de informações no canto superior esquerdo. Leia sobre a ferramenta e feche a página com o X."
          }
        }
      }
    },
    "Open the Angle page and set the nib angle to 20 degrees. Use the Digital Crown or the arrow buttons.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Angle page and set the nib angle to 20 degrees. Use the Digital Crown or the arrow buttons."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейди в раздел «Угол» и установи наклон наконечника 20 градусов колёсиком или кнопками со стрелками."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Angle et règle la pointe sur 20 degrés avec la Digital Crown ou les flèches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Winkel und stelle mit der Digital Crown oder den Pfeilen 20 Grad ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Angolo e imposta 20 gradi con la Digital Crown o le frecce."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ángulo y ajusta la punta a 20 grados con la Digital Crown o las flechas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ângulo e defina 20 graus com a Digital Crown ou as setas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الزاوية واضبطها على 20 درجة باستخدام Digital Crown أو الأسهم."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「角度」を開き、Digital Crownか矢印で20度にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각도를 열고 Digital Crown이나 화살표로 20도를 맞추세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“角度”，用数码表冠或箭头将笔尖设为20度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「角度」，用數位錶冠或箭頭將筆尖設為20度。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açı sayfasında Digital Crown veya oklarla ucu 20 dereceye ayarla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Kąt i ustaw 20 stopni za pomocą Digital Crown lub strzałek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Hoek en stel met de Digital Crown of pijlen 20 graden in."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Vinkel och ställ in 20 grader med Digital Crown eller pilarna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Vinkel og indstil 20 grader med Digital Crown eller pilene."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Vinkel og still inn 20 grader med Digital Crown eller pilene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Kulma ja aseta 20 astetta Digital Crownilla tai nuolilla."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोण पृष्ठ खोलें और निब का कोण 20 डिग्री करें। Digital Crown या तीर बटन इस्तेमाल करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோணப் பக்கத்தைத் திறந்து முனையின் கோணத்தை 20 டிகிரியாக அமைக்கவும். Digital Crown அல்லது அம்புப் பொத்தான்களைப் பயன்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కోణం పేజీ తెరిచి పెన్ కొన కోణాన్ని 20 డిగ్రీలకు సెట్ చేయండి. Digital Crown లేదా బాణం బటన్లు వాడండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोन पान उघडून टोकाचा कोन 20 अंश करा. Digital Crown किंवा बाणांची बटणे वापरा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખૂણાનું પાનું ખોલી અણીનો ખૂણો 20 ડિગ્રી કરો. Digital Crown અથવા તીર બટનો વાપરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਣ ਪੰਨਾ ਖੋਲ੍ਹ ਕੇ ਨੋਕ ਦਾ ਕੋਣ 20 ਡਿਗਰੀ ਕਰੋ। Digital Crown ਜਾਂ ਤੀਰ ਬਟਨ ਵਰਤੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোণ পৃষ্ঠা খুলে কলমের নিবের কোণ 20 ডিগ্রি করুন। Digital Crown বা তীর বোতাম ব্যবহার করুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka halaman Sudut dan atur sudut ujung pena ke 20 derajat. Gunakan Digital Crown atau tombol panah."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زاویہ صفحہ کھول کر نوک کا زاویہ 20 ڈگری کریں۔ Digital Crown یا تیر والے بٹن استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở trang Góc và đặt góc ngòi bút thành 20 độ. Dùng Digital Crown hoặc các nút mũi tên."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหน้ามุม แล้วตั้งมุมปลายปากกาเป็น 20 องศา ใช้ Digital Crown หรือปุ่มลูกศร"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka halaman Sudut dan tetapkan sudut mata pen kepada 20 darjah. Gunakan Digital Crown atau butang anak panah."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте розділ «Кут» і встановіть нахил наконечника 20 градусів за допомогою Digital Crown або кнопок зі стрілками."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete stránku Úhel a nastavte sklon hrotu na 20 stupňů pomocí Digital Crown nebo tlačítek se šipkami."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide pagina Unghi și setează înclinarea vârfului la 20 de grade. Folosește Digital Crown sau butoanele cu săgeți."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Szög oldalt, és állítsd a hegy szögét 20 fokra a Digital Crownnal vagy a nyílgombokkal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τη σελίδα Γωνία και ορίστε την κλίση της μύτης στις 20 μοίρες. Χρησιμοποιήστε το Digital Crown ή τα βέλη."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את עמוד ״זווית״ והגדירו זווית חוד של 20 מעלות באמצעות ה-Digital Crown או כפתורי החצים."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte stránku Uhol a nastavte sklon hrotu na 20 stupňov pomocou Digital Crown alebo tlačidiel so šípkami."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite stranicu Kut i postavite nagib vrha na 20 stupnjeva krunicom Digital Crown ili gumbima sa strelicama."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite stran Kot in nastavite naklon konice na 20 stopinj s krono Digital Crown ali puščičnima gumboma."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre la pàgina Angle i estableix la inclinació de la punta en 20 graus. Fes servir la Digital Crown o els botons de fletxa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ângulo e defina 20 graus com a Digital Crown ou as setas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a página Ângulo e defina a inclinação da ponta como 20 graus. Use a Digital Crown ou os botões de seta."
          }
        }
      }
    },
    "Tap the green checkmark to return to the canvas, then draw two strokes with your new brush.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the green checkmark to return to the canvas, then draw two strokes with your new brush."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми зелёную галочку, чтобы вернуться к холсту, и нарисуй два штриха новой кистью."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche la coche verte pour revenir à la toile, puis trace deux traits avec ce pinceau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den grünen Haken, um zur Leinwand zurückzukehren, und zeichne zwei Striche mit dem neuen Pinsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il segno di spunta verde per tornare alla tela, poi disegna due tratti con il nuovo pennello."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la marca verde para volver al lienzo y dibuja dos trazos con el pincel nuevo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no visto verde para voltar à tela e desenhe dois traços com o novo pincel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط علامة الصح الخضراء للعودة إلى اللوحة، ثم ارسم خطين بالفرشاة الجديدة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緑のチェックをタップしてキャンバスに戻り、新しいブラシで2本の線を描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초록 체크 표시를 눌러 캔버스로 돌아가 새 브러시로 선 두 개를 그리세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击绿色对勾返回画布，用新画笔画两笔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下綠色勾號返回畫布，用新畫筆畫兩筆。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeşil onay işaretine dokunarak tuvale dön ve yeni fırçayla iki çizgi çiz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij zielony znacznik, aby wrócić do płótna, i narysuj dwie kreski nowym pędzlem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het groene vinkje om naar het canvas terug te keren en teken twee lijnen met de nieuwe kwast."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på den gröna bocken för att återgå till duken och rita två streck med den nya penseln."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på det grønne flueben for at vende tilbage til lærredet og tegn to streger med den nye pensel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på det grønne merket for å gå tilbake til lerretet, og tegn to streker med den nye penselen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaa piirtoalueelle vihreästä valintamerkistä ja piirrä kaksi viivaa uudella siveltimellä."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हरे चेकमार्क से कैनवास पर लौटें और नए ब्रश से दो स्ट्रोक बनाएँ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பச்சைச் சரிக்குறியைத் தட்டி கேன்வாஸுக்குத் திரும்பி, புதிய தூரிகையால் இரண்டு கோடுகளை வரையுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆకుపచ్చ చెక్‌మార్క్‌తో కాన్వాస్‌కు తిరిగి వచ్చి కొత్త బ్రష్‌తో రెండు గీతలు గీయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हिरव्या टिकमार्कने कॅनव्हासवर परत जा आणि नव्या ब्रशने दोन रेषा काढा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લીલી નિશાનીથી કેનવાસ પર પાછા આવો અને નવા બ્રશથી બે રેખાઓ દોરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰੇ ਸਹੀ ਦੇ ਨਿਸ਼ਾਨ ਨਾਲ ਕੈਨਵਸ ਉੱਤੇ ਵਾਪਸ ਆਓ ਅਤੇ ਨਵੇਂ ਬੁਰਸ਼ ਨਾਲ ਦੋ ਲਕੀਰਾਂ ਬਣਾਓ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবুজ টিক চিহ্নে চাপ দিয়ে ক্যানভাসে ফিরুন এবং নতুন ব্রাশে দুটি রেখা আঁকুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tanda centang hijau untuk kembali ke kanvas, lalu buat dua goresan dengan kuas baru."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سبز ٹک سے کینوس پر واپس آئیں اور نئے برش سے دو لکیریں بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm dấu tích xanh để về khung vẽ, rồi vẽ hai nét bằng cọ mới."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเครื่องหมายถูกสีเขียวเพื่อกลับสู่ผืนผ้าใบ แล้ววาดสองเส้นด้วยแปรงใหม่"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik tanda semak hijau untuk kembali ke kanvas, kemudian lukis dua sapuan dengan berus baharu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть зелену галочку, щоб повернутися до полотна, і намалюйте два штрихи новим пензлем."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeleným zatržítkem se vraťte na plátno a nakreslete dva tahy novým štětcem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge bifa verde pentru a reveni la pânză, apoi desenează două tușe cu noua pensulă."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A zöld pipával térj vissza a vászonhoz, és rajzolj két vonást az új ecsettel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το πράσινο σημάδι επιλογής για επιστροφή στον καμβά και σχεδιάστε δύο πινελιές με το νέο πινέλο."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על סימן האישור הירוק כדי לחזור למשטח הציור, וציירו שתי משיכות במברשת החדשה."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelenou značkou potvrdenia sa vráťte na plátno a nakreslite dva ťahy novým štetcom."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite zelenu kvačicu za povratak na platno i nacrtajte dva poteza novim kistom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite zeleno kljukico za vrnitev na platno in narišite dve potezi z novim čopičem."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la marca verda per tornar al llenç i dibuixa dos traços amb el pinzell nou."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no visto verde para voltar à tela e desenhe dois traços com o novo pincel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na marca de seleção verde para voltar à tela e desenhe dois traços com o novo pincel."
          }
        }
      }
    },
    "Turn the Digital Crown to zoom the canvas in or out, then stop turning.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the Digital Crown to zoom the canvas in or out, then stop turning."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покрути колёсико часов, чтобы приблизить или отдалить холст, затем остановись."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne la Digital Crown pour zoomer sur la toile, puis arrête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehe die Digital Crown, um die Leinwand zu vergrößern oder zu verkleinern. Höre dann auf zu drehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota la Digital Crown per ingrandire o ridurre la tela, poi fermati."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la Digital Crown para acercar o alejar el lienzo y después deja de girar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rode a Digital Crown para ampliar ou reduzir a tela e depois pare."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدر Digital Crown لتكبير اللوحة أو تصغيرها، ثم توقف."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital Crownを回してキャンバスを拡大・縮小し、回すのを止めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital Crown을 돌려 캔버스를 확대하거나 축소한 뒤 멈추세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转动数码表冠缩放画布，然后停止转动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉動數位錶冠縮放畫布，然後停止轉動。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital Crown’u çevirerek tuvali yakınlaştır veya uzaklaştır, sonra dur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obróć Digital Crown, aby przybliżyć lub oddalić płótno, a potem przestań obracać."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai de Digital Crown om in of uit te zoomen en stop daarna met draaien."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrid på Digital Crown för att zooma in eller ut och sluta sedan vrida."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drej Digital Crown for at zoome ind eller ud og stop derefter med at dreje."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vri Digital Crown for å zoome inn eller ut, og slutt deretter å vri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähennä tai loitonna piirtoaluetta kiertämällä Digital Crownia ja lopeta sitten kiertäminen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital Crown घुमाकर कैनवास का ज़ूम बदलें, फिर घुमाना रोक दें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேன்வாஸைப் பெரிதாக்க அல்லது சிறிதாக்க Digital Crown-ஐச் சுழற்றி, பின்னர் நிறுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్వాస్‌ను జూమ్ చేయడానికి Digital Crown తిప్పి, తర్వాత ఆపండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅनव्हास जवळ किंवा दूर करण्यासाठी Digital Crown फिरवा, मग थांबा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેનવાસ ઝૂમ કરવા Digital Crown ફેરવો, પછી ફેરવવાનું બંધ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਨਵਸ ਨੂੰ ਜ਼ੂਮ ਕਰਨ ਲਈ Digital Crown ਘੁਮਾਓ, ਫਿਰ ਰੁਕ ਜਾਓ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যানভাস জুম করতে Digital Crown ঘোরান, তারপর ঘোরানো থামান।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar Digital Crown untuk memperbesar atau memperkecil kanvas, lalu berhenti memutar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کینوس کو بڑا یا چھوٹا کرنے کے لیے Digital Crown گھمائیں، پھر رک جائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoay Digital Crown để phóng to hoặc thu nhỏ khung vẽ, rồi ngừng xoay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมุน Digital Crown เพื่อซูมผืนผ้าใบเข้าหรือออก แล้วหยุดหมุน"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar Digital Crown untuk mengezum kanvas masuk atau keluar, kemudian berhenti memutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверніть Digital Crown, щоб змінити масштаб полотна, а потім зупиніться."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otáčením Digital Crown přibližte nebo oddalte plátno, pak přestaňte otáčet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotește Digital Crown pentru a mări sau micșora pânza, apoi oprește rotirea."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Digital Crown forgatásával nagyítsd vagy kicsinyítsd a vásznat, majd állj meg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιστρέψτε το Digital Crown για μεγέθυνση ή σμίκρυνση του καμβά και μετά σταματήστε."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סובבו את ה-Digital Crown כדי להגדיל או להקטין את משטח הציור, ואז הפסיקו לסובב."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otáčaním Digital Crown priblížte alebo oddiaľte plátno a potom prestaňte otáčať."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okrećite Digital Crown da biste povećali ili smanjili platno, a zatim prestanite okretati."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavrtite Digital Crown za povečavo ali pomanjšavo platna, nato prenehajte vrteti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la Digital Crown per ampliar o reduir el llenç i després deixa de girar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rode a Digital Crown para ampliar ou reduzir a tela e depois pare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire a Digital Crown para ampliar ou reduzir a tela e depois pare de girar."
          }
        }
      }
    },
    "You are in camera mode. Drag to move the canvas, then tap the green checkmark.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are in camera mode. Drag to move the canvas, then tap the green checkmark."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас включён режим камеры. Подвигай холст пальцем, затем нажми зелёную галочку."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es en mode caméra. Déplace la toile avec le doigt, puis touche la coche verte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist im Kameramodus. Verschiebe die Leinwand mit dem Finger und tippe auf den grünen Haken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei in modalità fotocamera. Trascina la tela, poi tocca il segno di spunta verde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en modo cámara. Arrastra el lienzo y toca la marca verde."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está no modo de câmara. Arraste a tela e toque no visto verde."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت في وضع الكاميرا. حرّك اللوحة بإصبعك ثم اضغط علامة الصح الخضراء."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラモードです。指でキャンバスを動かしてから緑のチェックをタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 모드입니다. 손가락으로 캔버스를 옮긴 뒤 초록 체크 표시를 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在处于相机模式。用手指拖动画布，然后点击绿色对勾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在處於相機模式。用手指拖動畫布，然後點一下綠色勾號。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera modundasın. Tuvali parmağınla taşı, ardından yeşil onay işaretine dokun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś w trybie kamery. Przesuń płótno palcem i stuknij zielony znacznik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent in de cameramodus. Verschuif het canvas met je vinger en tik op het groene vinkje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är i kameraläge. Flytta duken med fingret och tryck på den gröna bocken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er i kameratilstand. Flyt lærredet med fingeren og tryk på det grønne flueben."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er i kameramodus. Flytt lerretet med fingeren og trykk på det grønne merket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet kameratilassa. Siirrä piirtoaluetta sormella ja napauta vihreää valintamerkkiä."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कैमरा मोड में हैं। कैनवास खिसकाने के लिए उंगली खींचें, फिर हरा चेकमार्क दबाएँ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் கேமரா பயன்முறையில் இருக்கிறீர்கள். கேன்வாஸை நகர்த்த இழுத்து, பின்னர் பச்சைச் சரிக்குறியைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు కెమెరా మోడ్‌లో ఉన్నారు. కాన్వాస్‌ను జరపడానికి లాగి, ఆకుపచ్చ చెక్‌మార్క్ నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही कॅमेरा मोडमध्ये आहात. कॅनव्हास हलवण्यासाठी बोट ओढा, मग हिरवी टिक दाबा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે કૅમેરા મોડમાં છો. કેનવાસ ખસેડવા આંગળી ખેંચો, પછી લીલી નિશાની દબાવો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਕੈਮਰਾ ਮੋਡ ਵਿੱਚ ਹੋ। ਕੈਨਵਸ ਹਿਲਾਉਣ ਲਈ ਉਂਗਲ ਖਿੱਚੋ, ਫਿਰ ਹਰਾ ਸਹੀ ਦਾ ਨਿਸ਼ਾਨ ਦਬਾਓ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ক্যামেরা মোডে আছেন। ক্যানভাস সরাতে টেনে নিন, তারপর সবুজ টিক চিহ্ন চাপুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda berada dalam mode kamera. Seret untuk memindahkan kanvas, lalu ketuk tanda centang hijau."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کیمرا موڈ میں ہیں۔ کینوس کو حرکت دینے کے لیے انگلی کھینچیں، پھر سبز ٹک دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ở chế độ camera. Kéo để di chuyển khung vẽ, rồi chạm dấu tích xanh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยู่ในโหมดกล้อง ลากเพื่อเลื่อนผืนผ้าใบ แล้วแตะเครื่องหมายถูกสีเขียว"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dalam mod kamera. Seret untuk menggerakkan kanvas, kemudian ketik tanda semak hijau."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви в режимі камери. Перетягніть полотно пальцем і натисніть зелену галочку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste v režimu kamery. Tažením posuňte plátno a pak klepněte na zelené zatržítko."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești în modul cameră. Trage pentru a muta pânza, apoi atinge bifa verde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameramódban vagy. Húzással mozgasd a vásznat, majd koppints a zöld pipára."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε στη λειτουργία κάμερας. Σύρετε για να μετακινήσετε τον καμβά και πατήστε το πράσινο σημάδι επιλογής."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתם במצב מצלמה. גררו כדי להזיז את משטח הציור, ואז הקישו על סימן האישור הירוק."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste v režime kamery. Potiahnutím posuňte plátno a potom klepnite na zelenú značku potvrdenia."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U načinu ste kamere. Povucite za pomicanje platna, a zatim dodirnite zelenu kvačicu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste v načinu kamere. Povlecite za premik platna, nato tapnite zeleno kljukico."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ets en mode càmera. Arrossega per moure el llenç i toca la marca verda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está no modo de câmara. Arraste a tela e toque no visto verde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está no modo de câmera. Arraste para mover a tela e toque na marca de seleção verde."
          }
        }
      }
    },
    "Try Undo and Redo at the bottom. Use these buttons twice in total.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Undo and Redo at the bottom. Use these buttons twice in total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуй кнопки отмены и повтора внизу экрана. Нажми их в общей сложности два раза."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie Annuler et Rétablir en bas. Utilise ces boutons deux fois au total."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere unten Rückgängig und Wiederholen aus. Benutze die Tasten insgesamt zweimal."
          }
        },
        "it": {
          "stringUnit": {
