    "Block in flat colors, paint over mistakes, and add crisp details. Opaque strokes replace the color below. Lower opacity lets you build transitions gradually without extra darkening." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Block in flat colors, paint over mistakes, and add crisp details. Opaque strokes replace the color below. Lower opacity lets you build transitions gradually without extra darkening."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заливайте основные цвета, перекрывайте ошибки и добавляйте чёткие детали. Непрозрачный мазок заменяет нижний цвет. При меньшей прозрачности можно плавно набирать цвет без дополнительного затемнения."
          }
        }
      }
    },
