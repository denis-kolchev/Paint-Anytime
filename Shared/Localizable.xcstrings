        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பச்சை நிறத்தைத் தேர்வுசெய்ய Digital Crown-ஐச் சுழற்றுங்கள் அல்லது அருகிலுள்ள நிறத்தைத் தட்டுங்கள்."
