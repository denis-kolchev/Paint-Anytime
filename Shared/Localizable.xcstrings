        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos experimentar outro pincel. Toque no botão da ferramenta no canto superior direito."
          }
        }
      }
    },
    "Turn the Digital Crown or tap a neighboring color to select green.": {
