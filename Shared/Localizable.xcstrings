          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это учебные рисунки. Поверни колёсико или дважды нажми на рисунок, чтобы открыть его в полном размере."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont des images d’entraînement. Tourne la Digital Crown ou touche deux fois une image pour l’ouvrir en plein format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind Übungsbilder. Drehe die Digital Crown oder tippe zweimal auf ein Bild, um es in voller Größe zu öffnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi sono disegni di prova. Ruota la Digital Crown o tocca due volte un disegno per aprirlo a grandezza intera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son imágenes de práctica. Gira la Digital Crown o toca una imagen dos veces para abrirla a tamaño completo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são imagens de treino. Rode a Digital Crown ou toque duas vezes numa imagem para a abrir em tamanho completo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه صور للتدريب. أدر Digital Crown أو اضغط الصورة مرتين لفتحها بالحجم الكامل."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習用の画像です。Digital Crownを回すか画像を2回タップして、フルサイズで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습용 그림입니다. Digital Crown을 돌리거나 그림을 두 번 눌러 전체 크기로 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是练习图片。转动数码表冠或点击图片两次，以完整尺寸打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是練習圖片。轉動數位錶冠或點圖片兩次，以完整尺寸開啟。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar alıştırma resimleri. Digital Crown’u çevir veya bir resme iki kez dokunarak tam boyutta aç."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To obrazy do ćwiczeń. Obróć Digital Crown lub stuknij obraz dwa razy, aby otworzyć go w pełnym rozmiarze."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn oefenafbeeldingen. Draai de Digital Crown of tik twee keer op een afbeelding om deze op volledig formaat te openen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är övningsbilder. Vrid på Digital Crown eller tryck två gånger på en bild för att öppna den i full storlek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er øvebilleder. Drej Digital Crown eller tryk to gange på et billede for at åbne det i fuld størrelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er øvingsbilder. Vri Digital Crown eller trykk to ganger på et bilde for å åpne det i full størrelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä ovat harjoituskuvia. Kierrä Digital Crownia tai napauta kuvaa kahdesti avataksesi sen täysikokoisena."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये अभ्यास के चित्र हैं। पूरा आकार देखने के लिए Digital Crown घुमाएँ या किसी चित्र पर दो बार टैप करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இவை பயிற்சிப் படங்கள். முழு அளவில் திறக்க Digital Crown-ஐச் சுழற்றுங்கள் அல்லது படத்தை இருமுறை தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇవి అభ్యాస చిత్రాలు. పూర్తి పరిమాణంలో తెరవడానికి Digital Crown తిప్పండి లేదా చిత్రాన్ని రెండుసార్లు నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही सरावाची चित्रे आहेत. पूर्ण आकारात उघडण्यासाठी Digital Crown फिरवा किंवा चित्रावर दोनदा टॅप करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ અભ્યાસનાં ચિત્રો છે. પૂરા કદમાં ખોલવા Digital Crown ફેરવો અથવા ચિત્ર પર બે વાર ટૅપ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਅਭਿਆਸ ਦੀਆਂ ਤਸਵੀਰਾਂ ਹਨ। ਪੂਰੇ ਆਕਾਰ ਵਿੱਚ ਖੋਲ੍ਹਣ ਲਈ Digital Crown ਘੁਮਾਓ ਜਾਂ ਤਸਵੀਰ ਨੂੰ ਦੋ ਵਾਰ ਟੈਪ ਕਰੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এগুলো অনুশীলনের ছবি। পূর্ণ আকারে খুলতে Digital Crown ঘোরান বা ছবিতে দুবার ট্যাপ করুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah gambar latihan. Putar Digital Crown atau ketuk gambar dua kali untuk membukanya dalam ukuran penuh."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مشق کی تصویریں ہیں۔ پورے سائز میں کھولنے کے لیے Digital Crown گھمائیں یا تصویر کو دو بار تھپتھپائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là các ảnh thực hành. Xoay Digital Crown hoặc chạm ảnh hai lần để mở ở kích thước đầy đủ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือภาพฝึกหัด หมุน Digital Crown หรือแตะภาพสองครั้งเพื่อเปิดแบบเต็มขนาด"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ialah gambar latihan. Putar Digital Crown atau ketik gambar dua kali untuk membukanya pada saiz penuh."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це навчальні малюнки. Поверніть Digital Crown або двічі натисніть малюнок, щоб відкрити його в повному розмірі."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto jsou cvičné obrázky. Otáčením Digital Crown nebo dvojím klepnutím otevřete obrázek v plné velikosti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acestea sunt imagini de exercițiu. Rotește Digital Crown sau atinge o imagine de două ori pentru a o deschide la dimensiune completă."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek gyakorlóképek. Forgasd a Digital Crownt, vagy koppints kétszer egy képre a teljes méretű nézethez."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές είναι εικόνες εξάσκησης. Περιστρέψτε το Digital Crown ή πατήστε μια εικόνα δύο φορές για πλήρες μέγεθος."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אלו תמונות לתרגול. סובבו את ה-Digital Crown או הקישו פעמיים על תמונה כדי לפתוח אותה בגודל מלא."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto sú cvičné obrázky. Otáčaním Digital Crown alebo dvojitým klepnutím otvoríte obrázok v plnej veľkosti."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo su slike za vježbu. Okrećite Digital Crown ili dvaput dodirnite sliku da biste je otvorili u punoj veličini."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To so vadbene slike. Zavrtite Digital Crown ali dvakrat tapnite sliko, da jo odprete v polni velikosti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquestes són imatges de pràctica. Gira la Digital Crown o toca una imatge dues vegades per obrir-la a mida completa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são imagens de treino. Rode a Digital Crown ou toque duas vezes numa imagem para a abrir em tamanho completo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são imagens de prática. Gire a Digital Crown ou toque duas vezes em uma imagem para abri-la em tamanho completo."
          }
        }
      }
    },
    "Use the back button at the top left until you return to the canvas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the back button at the top left until you return to the canvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимай кнопку «Назад» слева вверху, пока не вернёшься к холсту."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le bouton Retour en haut à gauche jusqu’à retrouver la toile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben links auf Zurück, bis du wieder auf der Leinwand bist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Indietro in alto a sinistra finché non torni alla tela."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Atrás arriba a la izquierda hasta volver al lienzo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Voltar no canto superior esquerdo até regressar à tela."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم زر الرجوع الأعلى حتى تعود إلى اللوحة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上の戻るボタンでキャンバスまで戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 위 뒤로 버튼을 눌러 캔버스로 돌아가세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用左上角的返回按钮，直到回到画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用左上角的返回按鈕，直到回到畫布。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol üstteki Geri düğmesiyle tuvale dön."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj przycisku Wstecz w lewym górnym rogu, aż wrócisz do płótna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik linksboven Terug totdat je weer op het canvas bent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd Tillbaka uppe till vänster tills du återvänder till duken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug Tilbage øverst til venstre, indtil du er tilbage på lærredet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk Tilbake øverst til venstre til du kommer tilbake til lerretet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaa piirtoalueelle vasemman yläkulman Takaisin-painikkeella."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर बाईं ओर वापस बटन दबाते हुए कैनवास पर लौटें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேன்வாஸுக்குத் திரும்பும் வரை மேல் இடப்புறப் பின்செல் பொத்தானைப் பயன்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్వాస్‌కు తిరిగి వచ్చేవరకు ఎగువ ఎడమ మూలలో వెనుకకు బటన్ వాడండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅनव्हासवर परत येईपर्यंत वर डावीकडील मागे बटण वापरा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેનવાસ પર પાછા આવો ત્યાં સુધી ઉપર ડાબે પાછા બટન વાપરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਨਵਸ ਉੱਤੇ ਵਾਪਸ ਆਉਣ ਤੱਕ ਉੱਪਰ ਖੱਬੇ ਵਾਪਸ ਬਟਨ ਵਰਤੋ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যানভাসে না ফেরা পর্যন্ত ওপরে বাঁয়ের ফিরে যান বোতাম ব্যবহার করুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan tombol kembali di kiri atas hingga Anda kembali ke kanvas."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کینوس پر واپس آنے تک اوپر واپسی کا بٹن استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng nút quay lại ở góc trên bên trái cho đến khi về khung vẽ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปุ่มย้อนกลับที่มุมซ้ายบนจนกลับถึงผืนผ้าใบ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan butang kembali di kiri atas sehingga anda kembali ke kanvas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натискайте «Назад» ліворуч угорі, доки не повернетеся до полотна."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používejte tlačítko Zpět vlevo nahoře, dokud se nevrátíte na plátno."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește butonul Înapoi din stânga sus până revii la pânză."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bal felső Vissza gombbal térj vissza a vászonhoz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε το κουμπί Πίσω πάνω αριστερά μέχρι να επιστρέψετε στον καμβά."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו בכפתור החזרה בחלק העליון עד שתחזרו למשטח הציור."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používajte tlačidlo Späť vľavo hore, kým sa nevrátite na plátno."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrebljavajte gumb Natrag gore lijevo dok se ne vratite na platno."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabljajte gumb Nazaj zgoraj levo, dokler se ne vrnete na platno."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir el botó Enrere a dalt a l’esquerra fins que tornis al llenç."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Voltar no canto superior esquerdo até regressar à tela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o botão Voltar no canto superior esquerdo até retornar à tela."
          }
        }
      }
    },
    "Tap the broom in the lower-left corner and confirm to clear the practice canvas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the broom in the lower-left corner and confirm to clear the practice canvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми метлу слева внизу и подтверди очистку учебного холста."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le balai en bas à gauche et confirme pour effacer la toile d’entraînement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe unten links auf den Besen und bestätige, um die Übungsleinwand zu leeren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la scopa in basso a sinistra e conferma per svuotare la tela di prova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
