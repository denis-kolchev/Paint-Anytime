        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom bij Paint Anytime! Teken twee losse lijnen in het midden. Je eigen tekeningen blijven veilig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välkommen till Paint Anytime! Rita två separata streck i mitten. Dina egna teckningar är säkra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen til Paint Anytime! Tegn to separate streger i midten. Dine egne tegninger er sikre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen til Paint Anytime! Tegn to separate streker i midten. Dine egne tegninger er trygge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tervetuloa Paint Anytimeen! Piirrä keskelle kaksi erillistä viivaa. Omat piirroksesi pysyvät turvassa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytime में आपका स्वागत है! कैनवास के बीच में दो अलग-अलग स्ट्रोक बनाएँ। इस प्रशिक्षण के दौरान आपके अपने चित्र सुरक्षित हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytime-க்கு வரவேற்கிறோம்! கேன்வாஸின் நடுவில் இரண்டு தனித்தனி கோடுகளை வரையுங்கள். இந்தப் பயிற்சியில் உங்கள் சொந்த ஓவியங்கள் பாதுகாப்பாக இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytimeకి స్వాగతం! కాన్వాస్ మధ్యలో రెండు వేర్వేరు గీతలు గీయండి. ఈ శిక్షణలో మీ సొంత చిత్రాలు సురక్షితంగా ఉంటాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytime मध्ये स्वागत आहे! कॅनव्हासच्या मध्यभागी दोन स्वतंत्र रेषा काढा. या प्रशिक्षणात तुमची स्वतःची चित्रे सुरक्षित राहतील."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytimeમાં સ્વાગત છે! કેનવાસની વચ્ચે બે અલગ રેખાઓ દોરો. આ તાલીમ દરમિયાન તમારાં પોતાનાં ચિત્રો સુરક્ષિત છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytime ਵਿੱਚ ਜੀ ਆਇਆਂ ਨੂੰ! ਕੈਨਵਸ ਦੇ ਵਿਚਕਾਰ ਦੋ ਵੱਖਰੀਆਂ ਲਕੀਰਾਂ ਬਣਾਓ। ਇਸ ਸਿਖਲਾਈ ਦੌਰਾਨ ਤੁਹਾਡੀਆਂ ਆਪਣੀਆਂ ਤਸਵੀਰਾਂ ਸੁਰੱਖਿਅਤ ਹਨ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytime-এ স্বাগতম! ক্যানভাসের মাঝে দুটি আলাদা রেখা আঁকুন। এই প্রশিক্ষণে আপনার নিজের ছবিগুলো নিরাপদ থাকবে।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang di Paint Anytime! Buat dua goresan terpisah di tengah kanvas. Gambar pribadi Anda tetap aman selama tutorial ini."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint Anytime میں خوش آمدید! کینوس کے درمیان دو الگ لکیریں بنائیں۔ اس تربیت کے دوران آپ کی اپنی تصویریں محفوظ ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng đến với Paint Anytime! Vẽ hai nét riêng biệt ở giữa khung vẽ. Tranh của bạn vẫn an toàn trong bài hướng dẫn này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยินดีต้อนรับสู่ Paint Anytime! วาดเส้นแยกกันสองเส้นตรงกลางผืนผ้าใบ ภาพของคุณจะปลอดภัยระหว่างบทสอนนี้"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang ke Paint Anytime! Lukis dua sapuan berasingan di tengah kanvas. Lukisan peribadi anda kekal selamat semasa tutorial ini."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вітаємо в Paint Anytime! Намалюйте два окремі штрихи в центрі полотна. Ваші власні малюнки в безпеці під час навчання."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vítejte v Paint Anytime! Nakreslete dva samostatné tahy uprostřed plátna. Vaše vlastní kresby jsou během výuky v bezpečí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bun venit în Paint Anytime! Desenează două tușe separate în centrul pânzei. Desenele tale sunt în siguranță în timpul tutorialului."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üdv a Paint Anytime-ban! Rajzolj két külön vonást a vászon közepére. Saját rajzaid biztonságban vannak a bemutató alatt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καλώς ήρθατε στο Paint Anytime! Σχεδιάστε δύο ξεχωριστές πινελιές στο κέντρο του καμβά. Τα δικά σας σχέδια είναι ασφαλή κατά την εκμάθηση."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברוכים הבאים ל-Paint Anytime! ציירו שתי משיכות נפרדות במרכז משטח הציור. הציורים האישיים שלכם בטוחים במהלך ההדרכה."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitajte v Paint Anytime! Nakreslite dva samostatné ťahy uprostred plátna. Vaše vlastné kresby sú počas výučby v bezpečí."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobro došli u Paint Anytime! Nacrtajte dva odvojena poteza u sredini platna. Vaši osobni crteži sigurni su tijekom vodiča."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrodošli v Paint Anytime! Na sredini platna narišite dve ločeni potezi. Vaše lastne risbe so med vodičem na varnem."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et donem la benvinguda a Paint Anytime! Dibuixa dos traços separats al centre del llenç. Els teus dibuixos estan segurs durant aquest tutorial."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo ao Paint Anytime! Desenhe dois traços no centro. Os seus desenhos pessoais estão seguros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Boas-vindas ao Paint Anytime! Desenhe dois traços separados no centro da tela. Seus desenhos pessoais estão seguros durante este tutorial."
          }
        }
      }
    },
    "Let's try another brush. Tap the tool button in the upper-right corner.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's try another brush. Tap the tool button in the upper-right corner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Давай попробуем другую кисть. Нажми на кнопку инструмента в правом верхнем углу."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie un autre pinceau : touche le bouton de l’outil en haut à droite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere einen anderen Pinsel: Tippe oben rechts auf die Werkzeugtaste."
          }
        },
