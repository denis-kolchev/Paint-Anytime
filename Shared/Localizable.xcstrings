    "Scroll down to share your drawing, or tap × to close." : {
      "comment" : "Tutorial instruction or accessibility text. Keep concise for Apple Watch. Directional gestures mirror in right-to-left languages.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر لأسفل للمشاركة، أو اضغط × للإغلاق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posuňte dolů pro sdílení nebo klepněte na × pro zavření."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rul ned for at dele, eller tryk på × for at lukke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolle zum Teilen nach unten oder tippe zum Schließen auf ×."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε κύλιση προς τα κάτω για κοινή χρήση ή πατήστε × για κλείσιμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll down to share your drawing, or tap × to close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate hacia abajo para compartir o toca × para cerrar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa vierittämällä alas tai sulje napauttamalla ×."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites défiler vers le bas pour partager, ou touchez × pour fermer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גללו למטה לשיתוף, או הקישו על × לסגירה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görgess le a megosztáshoz, vagy koppints a × jelre a bezáráshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gulir ke bawah untuk berbagi, atau ketuk × untuk menutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri in basso per condividere o tocca × per chiudere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下にスクロールして共有するか、×で閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래로 스크롤해 공유하거나 ×를 탭해 닫으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rull ned for å dele, eller trykk på × for å lukke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrol omlaag om te delen of tik op × om te sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewiń w dół, aby udostępnić, lub stuknij ×, aby zamknąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role para baixo para compartilhar ou toque em × para fechar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloque-se para baixo para partilhar ou toque em × para fechar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутите вниз, чтобы поделиться, или нажмите ×, чтобы закрыть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulla nedåt för att dela eller tryck på × för att stänga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลื่อนลงเพื่อแชร์ หรือแตะ × เพื่อปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşmak için aşağı kaydır, kapatmak için × işaretine dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутіть униз, щоб поділитися, або натисніть ×, щоб закрити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn xuống để chia sẻ hoặc chạm × để đóng."
          }
