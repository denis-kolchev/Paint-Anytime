          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile toista sivellintä. Napauta työkalupainiketta oikeassa yläkulmassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
