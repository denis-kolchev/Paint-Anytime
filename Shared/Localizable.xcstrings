        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওপরে বাঁয়ে তিনটি বিন্দু চাপুন, তারপর গ্যালারি বেছে নিন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tiga titik di kiri atas, lalu pilih Galeri."
