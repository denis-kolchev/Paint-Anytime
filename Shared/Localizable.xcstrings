          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj inny pędzel. Stuknij przycisk narzędzia w prawym górnym rogu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een andere kwast. Tik rechtsboven op de gereedschapsknop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova en annan pensel. Tryck på verktygsknappen uppe till höger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv en anden pensel. Tryk på værktøjsknappen øverst til højre."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv en annen pensel. Trykk på verktøyknappen øverst til høyre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile toista sivellintä. Napauta työkalupainiketta oikeassa yläkulmassa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा ब्रश आज़माएँ। ऊपर दाईं ओर टूल बटन दबाएँ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறு தூரிகையை முயல்வோம். மேல் வலப்புறக் கருவிப் பொத்தானைத் தட்டுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరో బ్రష్ ప్రయత్నిద్దాం. ఎగువ కుడి మూలలో సాధనం బటన్ నొక్కండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दुसरा ब्रश वापरून पाहू. वर उजवीकडील साधन बटण दाबा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બીજું બ્રશ અજમાવીએ. ઉપર જમણી બાજુનું સાધન બટન દબાવો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਓ ਹੋਰ ਬੁਰਸ਼ ਅਜ਼ਮਾਈਏ। ਉੱਪਰ ਸੱਜੇ ਪਾਸੇ ਸੰਦ ਬਟਨ ਦਬਾਓ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য একটি ব্রাশ চেষ্টা করি। ওপরের ডান কোণে টুল বোতাম চাপুন।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mari mencoba kuas lain. Ketuk tombol alat di kanan atas."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئیں دوسرا برش آزمائیں۔ اوپر موجود ٹول بٹن دبائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử cọ khác. Chạm nút công cụ ở góc trên bên phải."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองใช้แปรงอื่นกัน แตะปุ่มเครื่องมือที่มุมขวาบน"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mari cuba berus lain. Ketik butang alat di sudut kanan atas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуймо інший пензель. Натисніть кнопку інструмента праворуч угорі."
